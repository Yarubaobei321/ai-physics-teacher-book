/* ============================================================
   圆环参数化模型  —— 用于水槽中标记等势点
   ------------------------------------------------------------
   单位: mm (OpenSCAD 内部单位即毫米, 无需换算)
   外径: 四款统一 6 mm ; 内径与高度按 VARIANTS 表区分
   通气孔: 无 (按任务要求不做通气孔)
   说明: 本文件是唯一的几何参数源。改下方参数表即可。
         导出 STL / 生成预览由 build_all.py 调用 OpenSCAD 命令行完成。
   ============================================================ */

/* ---------------- 全局参数 ---------------- */
OD          = 6;      // 外径 (mm) —— 四款一致
FN          = 256;    // 圆周分段数(只影响圆滑度, 不影响外廓尺寸)
GAP         = 2;      // 排盘时相邻圆环的净间隙 (mm)
N_PER_PLATE = 4;      // 每个排盘里的圆环个数

/* ---------------- 参数表 [款名, 内径ID, 高度H] ---------------- */
VARIANTS = [
  ["A", 3.0, 1.6],
  ["B", 2.4, 1.6],
  ["C", 3.0, 3.0],
  ["D", 2.4, 3.0],
];

/* ---------------- 本次导出选择 ---------------- */
variant = "A";       // 款名: "A" / "B" / "C" / "D"
mode    = "single";  // "single" = 单件;  "plate" = 排盘(该款 4 个)

/* ---------------- 查表函数 ---------------- */
function id_of(v) = [for (x = VARIANTS) if (x[0] == v) x[1]][0];
function h_of(v)  = [for (x = VARIANTS) if (x[0] == v) x[2]][0];

/* ---------------- 几何: 单个圆环 (实心带中心通孔) ---------------- */
module ring(id, h) {
    difference() {
        cylinder(d = OD, h = h, $fn = FN);                  // 外圆柱
        translate([0, 0, -1])                                // 中心通孔(上下都出头, 保证完全贯穿)
            cylinder(d = id, h = h + 2, $fn = FN);
    }
}

/* ---------------- 几何: 排盘 (同款 N_PER_PLATE 个, 沿 X 排列并居中) ---------------- */
module plate(id, h) {
    pitch = OD + GAP;
    x0    = -pitch * (N_PER_PLATE - 1) / 2;
    for (i = [0 : N_PER_PLATE - 1])
        translate([x0 + i * pitch, 0, 0]) ring(id, h);
}

/* ---------------- 输出 ---------------- */
if (mode == "plate")
    plate(id_of(variant), h_of(variant));
else
    ring(id_of(variant), h_of(variant));
