{
  "schema_version": "1.0",
  "card_id": "S1-COLLISION-MODEL-v0.3",
  "title": "S1一维碰撞动量审计台物理模型卡",
  "model_version": "v0.3-preaudit-2026-08-31",
  "review_status": "teacher_review_pending",
  "claim_ceiling": "解析模型、页面结构与9项自动预审在当前本地冻结版通过；物理教师终审、真实浏览器操作、课堂可用性、发布与学习效果均未完成。",
  "research_object": {
    "objects": [
      "位于同一直线上的物体1，质量m1、碰前速度u1、碰后速度v1",
      "位于同一直线上的物体2，质量m2、碰前速度u2、碰后速度v2"
    ],
    "process": "两个物体的一维弹性碰撞或完全非弹性碰撞；动画只表示碰前、事件和碰后三个状态。",
    "purpose": "让教师和学生同时检查正方向、个体动量、系统总动量、总动能与数据身份。"
  },
  "system_boundary": {
    "included": ["物体1", "物体2"],
    "external": ["地面或轨道的支持", "可能存在但首版未建模的摩擦、空气阻力和外力冲量"],
    "exchange_handling": "模型把碰撞短时过程中的系统外力冲量视为可忽略；若真实过程不满足此条件，不能用该模型宣称动量守恒。"
  },
  "interval": {
    "time": "比较碰撞前冻结状态与碰撞后冻结状态；不计算真实接触力随时间的连续过程。",
    "space": "一条有明确正方向的一维直线；首版约定物体1初始在左、物体2初始在右。",
    "states": ["before_collision", "collision_event_illustration", "after_collision"]
  },
  "assumptions": [
    {
      "assumption_id": "A-S1-01",
      "statement": "两个物体只作一维平动，不考虑旋转、二维斜碰与形变细节。",
      "status": "teacher_review_pending",
      "consequence": "结果不能迁移到二维碰撞、带转动碰撞或需要接触力时间曲线的任务。"
    },
    {
      "assumption_id": "A-S1-02",
      "statement": "碰撞过程系统外力冲量可忽略。",
      "status": "verified",
      "consequence": "在该条件下使用系统总动量守恒；真实实验仍需另证外力冲量影响。"
    },
    {
      "assumption_id": "A-S1-03",
      "statement": "质量均为正有限数；原型输入范围为0.1—10 kg，速度范围为-10—10 m/s。",
      "status": "verified",
      "consequence": "范围外输入不在v0.3自动测试主张内。"
    },
    {
      "assumption_id": "A-S1-04",
      "statement": "首版碰撞类型只包含完全弹性和完全非弹性。",
      "status": "teacher_review_pending",
      "consequence": "不支持恢复系数连续变化、部分非弹性或材料拟合。"
    }
  ],
