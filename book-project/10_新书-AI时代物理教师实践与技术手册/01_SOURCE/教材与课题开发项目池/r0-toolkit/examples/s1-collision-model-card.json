  "core_relations": [
    {
      "relation_id": "R-S1-MOMENTUM",
      "name": "一维碰撞动量守恒",
      "expression": "m1*u1 + m2*u2 = m1*v1 + m2*v2",
      "conditions": ["物体1与物体2组成系统", "碰撞短时过程系统外力冲量可忽略", "所有速度使用同一正方向"],
      "status": "verified"
    },
    {
      "relation_id": "R-S1-ELASTIC",
      "name": "一维完全弹性碰撞通式",
      "expression": "v1=((m1-m2)*u1+2*m2*u2)/(m1+m2); v2=(2*m1*u1+(m2-m1)*u2)/(m1+m2)",
      "conditions": ["一维完全弹性碰撞", "总动量与总动能守恒", "m1>0且m2>0"],
      "status": "teacher_review_pending"
    },
    {
      "relation_id": "R-S1-INELASTIC",
      "name": "一维完全非弹性碰撞共同速度",
      "expression": "v=(m1*u1+m2*u2)/(m1+m2)",
      "conditions": ["碰后两物体共同运动", "碰撞短时过程系统外力冲量可忽略", "m1>0且m2>0"],
      "status": "verified"
    },
    {
      "relation_id": "R-S1-EVENT",
      "name": "首版追碰条件",
      "expression": "物体1初始在左、物体2初始在右且初始间距为正时，u1>u2才会在未来追碰",
      "conditions": ["两物体沿同一直线", "初始位置顺序固定", "速度在碰前保持常量"],
      "status": "teacher_review_pending"
    }
  ],
  "applicability_boundaries": [
    "原型只覆盖m1、m2在0.1—10 kg及u1、u2在-10—10 m/s的有限输入。",
    "u1≤u2时仍可计算假设碰撞后的解析速度，但页面不得播放成未来必然发生的追碰事件。",
    "动画、箭头、条形图和数值均为解析模型输出，不是实测数据。",
