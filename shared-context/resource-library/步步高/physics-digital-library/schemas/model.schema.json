{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/model.schema.json",
  "title": "步步高物理模型记录",
  "type": "object",
  "required": ["id", "relative_path", "status", "label", "description", "knowledge_ids", "source_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^model\\.bbg\\.[a-z0-9][a-z0-9._-]*$"},
    "relative_path": {"$ref": "#/$defs/relativePath"},
    "status": {"$ref": "#/$defs/status"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "knowledge_ids": {"type": "array", "items": {"type": "string", "pattern": "^kn\\.bbg\\.[a-z0-9][a-z0-9._-]*$"}},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^src\\.bbg\\.[0-9a-f]{64}$"}}
  },
  "additionalProperties": false,
  "$defs": {
    "status": {"enum": ["discovered", "raw_extracted", "ai_structured", "pending_manual_review", "reviewed", "published", "blocked"]},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
  }
}
