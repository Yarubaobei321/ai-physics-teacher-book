---
import ExperimentReview from './ExperimentReview.astro';
import LabDraftNotice from './LabDraftNotice.astro';
import LabSectionNav from './LabSectionNav.astro';
import { curvedRampReview } from '../data/lab-reviews/curved-ramp';

const measurementPoints = [
  { key: 'A', label: 'A' },
  { key: 'B', label: 'B' },
  { key: 'C', label: 'C' },
  { key: 'F1', label: '自由选点 1' },
  { key: 'F2', label: '自由选点 2' }
];
const apparatus = ['DIS机械能实验器', '自制光电门', '金属圆柱体'];
const steps = [
  '测量金属圆柱体的直径',
  'A、B、C 三点离 D 点高度分别为 15 cm、10 cm、5 cm，由静止释放金属圆柱体',
  '测量圆柱体质心通过 D 点速度并代入表达式验证'
];
---

<section class="bg-lab">
  <div class="page-shell py-12 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <a href="/online-lab/" class="focus-ring inline-flex rounded-md text-sm font-bold text-yucai-700 hover:text-yucai-900">
          返回在线实验室
        </a>
        <p class="eyebrow mt-8">MECHANICAL ENERGY</p>
        <h1 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-5xl">沿曲线运动验证机械能守恒定律</h1>
        <LabSectionNav slug="curved-ramp" />
        <p class="mt-5 leading-8 text-slate-700">
          从 A、B、C 点静止释放金属圆柱体，读取它到达 D 点附近双头光电门时的速度，比较重力势能减小量
          <span class="font-mono font-bold text-yucai-800">mgΔh</span>
          与动能增加量
          <span class="font-mono font-bold text-yucai-800">1/2mv² - 0</span>
          是否接近。
        </p>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div class="rounded-md border border-slate-200 bg-white p-5">
            <h2 class="text-base font-black text-ink">实验器材</h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {apparatus.map((item) => <span class="rounded-md bg-yucai-50 px-3 py-2 text-sm font-bold text-yucai-800">{item}</span>)}
            </div>
          </div>

          <div class="rounded-md border border-slate-200 bg-white p-5">
            <h2 class="text-base font-black text-ink">实验步骤</h2>
            <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-6 text-slate-700">
              {steps.map((step) => <li class="pl-1 marker:font-black marker:text-yucai-700">{step}</li>)}
            </ol>
          </div>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-[560px] overflow-hidden rounded-md border border-slate-200 bg-white shadow-soft lg:justify-self-end">
        <img
          src="/images/mechanical-energy-curved-ramp.png"
          alt="沿曲线运动法验证机械能守恒的 DIS 机械能实验器与光电门"
          class="max-h-[500px] w-full object-contain"
        />
      </figure>
    </div>

    <div id="lab-workbench" class="tool-surface mt-10 overflow-hidden scroll-mt-24">
      <LabDraftNotice />
      <div class="border-b border-slate-200 bg-white px-5 py-5 sm:px-6">
        <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(420px,auto)] xl:items-end">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.18em] text-yucai-700">DATA WORKBENCH</p>
            <h2 class="mt-2 text-2xl font-black text-ink">沿曲线运动数据表格与能量图像</h2>
            <p class="mt-3 leading-7 text-slate-700">
              双头光电门速度来自“两探头距离 ÷ 时间差”。金属圆柱体直径按实验步骤记录，不参与双头光电门测速计算。
            </p>
          </div>

          <div class="space-y-3">
            <div class="grid gap-3">
              <label class="block">
                <span class="text-xs font-bold text-slate-600">实验小组名称</span>
                <input
                  id="group-name"
                  class="focus-ring mt-2 h-11 w-full rounded-md border border-slate-300 bg-white px-3 text-sm font-bold text-ink"
                  type="text"
                  value="第 1 小组"
                  autocomplete="off"
                />
              </label>
            </div>

            <div class="flex flex-wrap gap-3">
              <button
                id="manual-mode"
                class="focus-ring h-11 rounded-md border border-yucai-600 px-4 text-sm font-bold text-yucai-700 transition hover:bg-yucai-50"
                type="button"
              >
                手动录入
              </button>
              <button
                id="serial-mode"
                class="focus-ring h-11 rounded-md border border-slate-300 px-4 text-sm font-bold text-slate-700 transition hover:bg-slate-100"
                type="button"
              >
                串口输入
              </button>
              <button
                id="ble-mode"
                class="focus-ring h-11 rounded-md border border-slate-300 px-4 text-sm font-bold text-slate-700 transition hover:bg-slate-100"
                type="button"
              >
                蓝牙输入
              </button>
              <button
                id="ai-simulate"
                class="focus-ring hidden h-11 rounded-md border border-slate-300 px-4 text-sm font-bold text-slate-700 transition hover:bg-slate-100"
                type="button"
              >
                AI模拟
              </button>
              <button
                id="clear-data"
                class="focus-ring h-11 rounded-md border border-slate-300 px-4 text-sm font-bold text-slate-700 transition hover:bg-slate-100"
                type="button"
              >
                一键数据清除
              </button>
              <button
                id="export-csv"
                class="focus-ring h-11 rounded-md border border-slate-300 px-4 text-sm font-bold text-slate-700 transition hover:bg-slate-100"
                type="button"
              >
                导出CSV
              </button>
              <button
                id="export-screenshot"
                class="focus-ring h-11 rounded-md border border-slate-300 px-4 text-sm font-bold text-slate-700 transition hover:bg-slate-100"
                type="button"
              >
                导出截图
              </button>
            </div>
          </div>
        </div>
      </div>

      <div id="lab-report-panel" class="bg-white">
        <div class="p-5 sm:p-6">
          <div class="grid gap-4 sm:grid-cols-3">
            <label class="block rounded-md bg-yucai-50 p-4">
              <span class="text-xs font-bold text-slate-600">金属圆柱体质量 m / g</span>
              <input
                id="mass-input"
                class="focus-ring mt-2 h-10 w-full rounded-md border border-yucai-200 bg-white px-3 font-mono text-sm"
                type="number"
                value="100"
                step="1"
                min="0.001"
                inputmode="decimal"
              />
            </label>
            <label class="block rounded-md bg-yucai-50 p-4">
              <span class="text-xs font-bold text-slate-600">重力加速度 g / (m/s²)</span>
              <input
                id="gravity-input"
                class="focus-ring mt-2 h-10 w-full rounded-md border border-yucai-200 bg-white px-3 font-mono text-sm"
                type="number"
                value="9.7880"
                step="0.0001"
                min="0.0001"
                inputmode="decimal"
              />
            </label>
            <label class="block rounded-md bg-yucai-50 p-4">
              <span class="text-xs font-bold text-slate-600">金属圆柱体直径 d / cm（记录）</span>
              <input
                id="cylinder-diameter-input"
                class="focus-ring mt-2 h-10 w-full rounded-md border border-yucai-200 bg-white px-3 font-mono text-sm"
                type="number"
                value="1.0000"
                step="0.0001"
                min="0"
                inputmode="decimal"
              />
            </label>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_340px]">
            <div class="rounded-md bg-slate-100 px-4 py-3 text-sm leading-7 text-slate-700">
              <p>
                D 为最低点和光电门位置。填写或采集 A、B、C 及自由选点释放后到达 D 点的速度。<strong>相对 D 的高度 h 请用 cm 填写</strong>
                ，页面计算势能时会自动换算为 m。
              </p>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <div class="rounded-md bg-white px-4 py-3">
                  <p class="text-xs font-bold text-slate-500">重力势能减少量</p>
                  <p class="mt-2 text-lg font-black text-ink" data-latex="Delta E_p = mg Delta h">ΔE<sub>p</sub> = mgΔh</p>
                </div>
                <div class="rounded-md bg-white px-4 py-3">
                  <p class="text-xs font-bold text-slate-500">动能增加量</p>
                  <p class="mt-2 text-lg font-black text-ink" data-latex="Delta E_k = 1/2mv^2 - 0">
                    ΔE<sub>k</sub> =
                    <span class="inline-flex flex-col align-middle text-center leading-tight">
                      <span class="border-b border-ink px-2">1</span>
                      <span>2</span>
                    </span>
                    mv² - 0
                  </p>
                </div>
              </div>
            </div>

            <div class="rounded-md border border-slate-200 bg-white p-4">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-black uppercase tracking-[0.16em] text-yucai-700">LIVE INPUT</p>
                  <p id="input-status" class="mt-2 text-sm font-bold leading-6 text-ink">当前为手动录入</p>
                </div>
                <p id="mode-label" class="shrink-0 rounded-md bg-yucai-50 px-2 py-1 text-xs font-bold text-yucai-800">手动录入</p>
              </div>

              <div id="serial-panel" class="mt-4 hidden">
                <div class="grid grid-cols-2 gap-3">
                  <button id="serial-connect" class="focus-ring h-10 rounded-md bg-yucai-700 px-3 text-sm font-bold text-white transition hover:bg-yucai-800" type="button">
                    连接串口
                  </button>
                  <button id="serial-clear-log" class="focus-ring h-10 rounded-md border border-slate-300 px-3 text-sm font-bold text-slate-700 transition hover:bg-slate-100" type="button">
                    清空日志
                  </button>
                </div>
                <pre id="serial-log" class="mt-3 h-32 overflow-auto whitespace-pre-wrap break-words rounded-md bg-slate-950 p-3 text-xs leading-5 text-blue-50">等待串口数据...</pre>
              </div>

              <div id="ble-panel" class="mt-4 hidden">
                <label class="block">
                  <span class="text-xs font-bold text-slate-600">蓝牙名称前缀</span>
                  <input
                    id="ble-name-prefix"
                    class="focus-ring mt-2 h-10 w-full rounded-md border border-slate-300 bg-white px-3 text-sm"
                    value="ESP32-gate"
                    autocomplete="off"
                  />
                </label>
                <div class="mt-3 grid grid-cols-2 gap-3">
                  <button id="ble-connect-prefix" class="focus-ring h-10 rounded-md bg-yucai-700 px-3 text-sm font-bold text-white transition hover:bg-yucai-800" type="button">
                    按名称连接
                  </button>
                  <button id="ble-connect-all" class="focus-ring h-10 rounded-md border border-yucai-600 px-3 text-sm font-bold text-yucai-700 transition hover:bg-yucai-50" type="button">
                    搜索所有蓝牙
                  </button>
                </div>
                <p id="ble-status" class="mt-3 text-sm font-bold leading-6 text-yucai-800">等待连接 ESP32-gate 双头光电门</p>
              </div>
            </div>
          </div>

          <div id="velocity-record-panel" class="mt-5 hidden">
            <div class="rounded-md bg-slate-950 p-4">
              <canvas id="velocity-chart" class="h-[360px] w-full" aria-label="双头光电门速度测量图像"></canvas>
            </div>

            <div class="mt-4 overflow-hidden rounded-md border border-slate-200 bg-white">
              <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
                <h3 class="text-base font-black text-ink">双头光电门测量记录</h3>
                <button
                  id="clear-velocity-records"
                  class="focus-ring h-9 rounded-md border border-slate-300 px-3 text-sm font-bold text-slate-700 transition hover:bg-slate-100"
                  type="button"
                >
                  清空记录
                </button>
              </div>
              <div class="max-h-72 overflow-auto">
                <table class="w-full min-w-[920px] text-left text-sm">
                  <thead class="sticky top-0 bg-slate-100 text-xs font-black text-slate-600">
                    <tr>
                      <th class="px-4 py-3">序号</th>
                      <th class="px-4 py-3">来源</th>
                      <th class="px-4 py-3">在线时间</th>
                      <th class="px-4 py-3">设备时间 / s</th>
                      <th class="px-4 py-3">时间差 / us</th>
                      <th class="px-4 py-3">速度 / m/s</th>
                      <th class="px-4 py-3">填入表格</th>
                    </tr>
                  </thead>
                  <tbody id="velocity-record-table-body" class="divide-y divide-slate-100 text-slate-700">
                    <tr>
                      <td class="px-4 py-4 text-slate-500" colspan="7">等待双头光电门触发</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="mt-5 overflow-x-auto rounded-md border border-slate-200">
            <table class="min-w-[1120px] w-full text-left text-base">
              <thead class="bg-slate-100 text-sm font-black text-slate-600">
                <tr>
                  <th class="w-60 px-4 py-4">测量项目</th>
                  {measurementPoints.map((point) => <th class="px-4 py-4 text-center">{point.label}</th>)}
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr>
                  <th class="px-4 py-4 font-bold text-ink">相对 D 的高度 h / cm（填写）</th>
                  {
                    measurementPoints.map((point) => (
                      <td class="px-4 py-4 text-center">
                        <input
                          class="focus-ring h-12 w-32 rounded-md border border-slate-300 bg-white px-3 font-mono text-base disabled:bg-slate-100 disabled:text-slate-500"
                          data-height-input
                          data-point={point.key}
                          type="number"
                          step="0.01"
                          min="0"
                          inputmode="decimal"
                          aria-label={`${point.label} 点相对 D 的高度，单位厘米`}
                        />
                      </td>
                    ))
                  }
                </tr>
                <tr>
                  <th class="px-4 py-4 font-bold text-ink">到达 D 的速度 v / (m/s)（填写）</th>
                  {
                    measurementPoints.map((point) => (
                      <td class="px-4 py-4 text-center">
                        <input
                          class="focus-ring h-12 w-32 rounded-md border border-slate-300 bg-white px-3 font-mono text-base disabled:bg-slate-100 disabled:text-slate-500"
                          data-velocity-input
                          data-point={point.key}
                          type="number"
                          step="0.0001"
                          min="0"
                          inputmode="decimal"
                          aria-label={`${point.label} 点释放后到达 D 的速度`}
                        />
                      </td>
                    ))
                  }
                </tr>
                <tr>
                  <th class="bg-amber-50 px-4 py-4 font-bold text-amber-800">重力势能减少量 ΔEp / J</th>
                  {
                    measurementPoints.map((point) => (
                      <td class="bg-amber-50/70 px-4 py-4 text-center font-mono tabular-nums font-bold text-amber-900" data-field="potential" data-point={point.key}></td>
                    ))
                  }
                </tr>
                <tr>
                  <th class="bg-sky-50 px-4 py-4 font-bold text-sky-800">动能增加量 ΔEk / J</th>
                  {
                    measurementPoints.map((point) => (
                      <td class="bg-sky-50/70 px-4 py-4 text-center font-mono tabular-nums font-bold text-sky-900" data-field="kinetic" data-point={point.key}></td>
                    ))
                  }
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <aside class="border-t border-slate-200 bg-white p-5 sm:p-6">
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-md bg-yucai-50 p-4">
              <p class="text-xs font-bold text-slate-500">可绘图点</p>
              <p id="chart-point-count" class="mt-1 font-mono text-2xl font-black text-yucai-800">0</p>
            </div>
            <div class="rounded-md bg-slate-100 p-4">
              <p class="text-xs font-bold text-slate-500">最近速度</p>
              <p id="latest-velocity" class="mt-1 font-mono text-2xl font-black text-ink">--</p>
            </div>
          </div>

          <div id="lab-analysis" class="relative mt-5 scroll-mt-24 rounded-md bg-slate-950 p-4">
            <canvas id="energy-bar-chart" class="h-[420px] w-full" aria-label="各测量点势能减小和动能增加柱状图"></canvas>
            <div
              id="energy-tooltip"
              class="pointer-events-none absolute hidden w-56 rounded-md border border-blue-100/30 bg-slate-900/95 px-3 py-2 text-xs leading-5 text-blue-50 shadow-xl"
              aria-live="polite"
            >
            </div>
            <p id="bar-chart-empty" class="pointer-events-none absolute inset-x-6 top-1/2 -translate-y-1/2 text-center text-sm font-bold text-blue-100">
              请至少填写一个测量点
            </p>
          </div>

        </aside>
      </div>
    </div>
  </div>

  <script>
    import { bindLabDraft } from '../lib/lab-draft';
    type RampPointKey = 'C' | 'B' | 'A' | 'F1' | 'F2';
    type InputMode = 'manual' | 'serial' | 'ble';
    type ChartBarKind = 'potential' | 'kinetic';

    type RampRow = {
      point: RampPointKey;
      heightCm: number | null;
      heightM: number | null;
      velocity: number | null;
      potentialDecrease: number | null;
      kineticIncrease: number | null;
      relativeError: number | null;
      chartReady: boolean;
    };

    type ChartPoint = {
      point: RampPointKey;
      potentialDecrease: number;
      kineticIncrease: number;
      relativeError: number | null;
    };

    type ChartHitArea = {
      x: number;
      y: number;
      width: number;
      height: number;
      kind: ChartBarKind;
      point: ChartPoint;
      label: string;
      value: number;
    };

    type CapturedVelocityMeta = {
      source: '串口' | '蓝牙';
      deviceTime?: number;
      gateDeltaUs?: number;
      raw?: string;
    };

    type VelocityRecord = CapturedVelocityMeta & {
      id: number;
      velocity: number;
      onlineTimeMs: number;
    };

    type SerialPortLike = {
      open: (options: { baudRate: number }) => Promise<void>;
      close: () => Promise<void>;
      readable: ReadableStream<Uint8Array> | null;
      writable: WritableStream<Uint8Array> | null;
    };

    type SerialNavigator = Navigator & {
      serial?: {
        requestPort: () => Promise<SerialPortLike>;
      };
    };

    type BluetoothRequestFilter = {
      name?: string;
      namePrefix?: string;
      services?: string[];
    };

    type BluetoothRequestOptions = {
      filters?: BluetoothRequestFilter[];
      acceptAllDevices?: boolean;
      optionalServices?: string[];
    };

    type BluetoothRemoteGATTCharacteristicLike = EventTarget & {
      startNotifications: () => Promise<BluetoothRemoteGATTCharacteristicLike>;
      value?: DataView;
    };

    type BluetoothRemoteGATTServiceLike = {
      getCharacteristic: (characteristicUuid: string) => Promise<BluetoothRemoteGATTCharacteristicLike>;
    };

    type BluetoothRemoteGATTServerLike = {
      connected?: boolean;
      disconnect: () => void;
      getPrimaryService: (serviceUuid: string) => Promise<BluetoothRemoteGATTServiceLike>;
    };

    type BluetoothDeviceLike = {
      name?: string;
      gatt?: BluetoothRemoteGATTServerLike & { connect: () => Promise<BluetoothRemoteGATTServerLike> };
    };

    type BluetoothLike = {
      requestDevice: (options: BluetoothRequestOptions) => Promise<BluetoothDeviceLike>;
    };

    const pointOrder: RampPointKey[] = ['A', 'B', 'C', 'F1', 'F2'];
    const nonZeroPoints: RampPointKey[] = [...pointOrder];
    const pointLabels: Record<RampPointKey, string> = {
      C: 'C',
      B: 'B',
      A: 'A',
      F1: '自由选点 1',
      F2: '自由选点 2'
    };
    const simulatedData: Record<RampPointKey, { heightCm: number; velocity: number }> = {
      C: { heightCm: 5.5, velocity: 1.03 },
      B: { heightCm: 11.5, velocity: 1.48 },
      A: { heightCm: 20.5, velocity: 1.98 },
      F1: { heightCm: 8.0, velocity: 1.25 },
      F2: { heightCm: 16.0, velocity: 1.74 }
    };

    const heightInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-height-input]'));
    const velocityInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-velocity-input]'));
    const groupNameInput = document.querySelector<HTMLInputElement>('#group-name');
    const massInput = document.querySelector<HTMLInputElement>('#mass-input');
    const gravityInput = document.querySelector<HTMLInputElement>('#gravity-input');
    const cylinderDiameterInput = document.querySelector<HTMLInputElement>('#cylinder-diameter-input');
    const manualButton = document.querySelector<HTMLButtonElement>('#manual-mode');
    const serialModeButton = document.querySelector<HTMLButtonElement>('#serial-mode');
    const bleModeButton = document.querySelector<HTMLButtonElement>('#ble-mode');
    const simulateButton = document.querySelector<HTMLButtonElement>('#ai-simulate');
    const clearButton = document.querySelector<HTMLButtonElement>('#clear-data');
    const exportCsvButton = document.querySelector<HTMLButtonElement>('#export-csv');
    const exportScreenshotButton = document.querySelector<HTMLButtonElement>('#export-screenshot');
    const serialPanel = document.querySelector<HTMLDivElement>('#serial-panel');
    const blePanel = document.querySelector<HTMLDivElement>('#ble-panel');
    const velocityRecordPanel = document.querySelector<HTMLDivElement>('#velocity-record-panel');
    const velocityChart = document.querySelector<HTMLCanvasElement>('#velocity-chart');
    const velocityRecordTableBody = document.querySelector<HTMLTableSectionElement>('#velocity-record-table-body');
    const clearVelocityRecordsButton = document.querySelector<HTMLButtonElement>('#clear-velocity-records');
    const serialConnectButton = document.querySelector<HTMLButtonElement>('#serial-connect');
    const serialClearLogButton = document.querySelector<HTMLButtonElement>('#serial-clear-log');
    const serialLog = document.querySelector<HTMLPreElement>('#serial-log');
    const bleNamePrefixInput = document.querySelector<HTMLInputElement>('#ble-name-prefix');
    const bleConnectPrefixButton = document.querySelector<HTMLButtonElement>('#ble-connect-prefix');
    const bleConnectAllButton = document.querySelector<HTMLButtonElement>('#ble-connect-all');
    const bleStatus = document.querySelector<HTMLParagraphElement>('#ble-status');
    const inputStatus = document.querySelector<HTMLParagraphElement>('#input-status');
    const modeLabel = document.querySelector<HTMLParagraphElement>('#mode-label');
    const barChart = document.querySelector<HTMLCanvasElement>('#energy-bar-chart');
    const energyTooltip = document.querySelector<HTMLDivElement>('#energy-tooltip');
    const barChartEmpty = document.querySelector<HTMLParagraphElement>('#bar-chart-empty');
    const pointCountLabel = document.querySelector<HTMLParagraphElement>('#chart-point-count');
    const latestVelocityLabel = document.querySelector<HTMLParagraphElement>('#latest-velocity');

    const decoder = new TextDecoder();
    const maxLogLength = 30000;
    const phyphoxExperimentServiceUuid = 'cddf0001-30f7-4671-8b43-5e40ba53514a';
    const phyphoxDataServiceUuid = 'cddf1001-30f7-4671-8b43-5e40ba53514a';
    const phyphoxDataCharacteristicUuid = 'cddf1002-30f7-4671-8b43-5e40ba53514a';
    const phyphoxServiceUuids = [phyphoxExperimentServiceUuid, phyphoxDataServiceUuid];

    let currentMode: InputMode = 'manual';
    let latestVelocity: number | null = null;
    const velocityRecords: VelocityRecord[] = [];
    let velocityRecordSequence = 0;
    let chartHitAreas: ChartHitArea[] = [];
    let activeChartSelection: { point: RampPointKey; kind: ChartBarKind } | null = null;
    let serialPort: SerialPortLike | null = null;
    let serialReader: ReadableStreamDefaultReader<Uint8Array> | null = null;
    let serialLineBuffer = '';
    let serialReadLoopStarted = false;
    let selectedBleDevice: BluetoothDeviceLike | null = null;
    let bleDataCharacteristic: BluetoothRemoteGATTCharacteristicLike | null = null;
    let bleDeviceName = '';

    const getNumericValue = (input: HTMLInputElement | null, fallback: number) => {
      const value = Number(input?.value);
      return Number.isFinite(value) && value >= 0 ? value : fallback;
    };

    const getPositiveNumericValue = (input: HTMLInputElement | null, fallback: number) => {
      const value = Number(input?.value);
      return Number.isFinite(value) && value > 0 ? value : fallback;
    };

    const formatNumber = (value: number | null, digits = 4) => {
      if (value === null || !Number.isFinite(value)) return '';
      return value.toFixed(digits);
    };

    const formatEnergyValue = (value: number) => `${value.toFixed(4)} J`;

    const readGroupName = () => {
      const value = groupNameInput?.value.trim();
      return value || '未命名小组';
    };

    const getInputByPoint = (inputs: HTMLInputElement[], point: RampPointKey) =>
      inputs.find((input) => input.dataset.point === point) ?? null;

    const setCell = (point: RampPointKey, field: string, value: string) => {
      const cell = document.querySelector<HTMLElement>(`[data-field="${field}"][data-point="${point}"]`);
      if (cell) cell.textContent = value;
    };

    const readRows = () => {
      const massG = getPositiveNumericValue(massInput, 100);
      const massKg = massG / 1000;
      const gravity = getPositiveNumericValue(gravityInput, 9.788);

      const rows: RampRow[] = pointOrder.map((point) => {
        const heightInput = getInputByPoint(heightInputs, point);
        const velocityInput = getInputByPoint(velocityInputs, point);
        const rawHeightCm = heightInput?.value.trim() === '' ? null : Number(heightInput?.value);
        const heightCm = rawHeightCm !== null && Number.isFinite(rawHeightCm) ? rawHeightCm : null;
        const heightM = heightCm !== null ? heightCm / 100 : null;
        const rawVelocity = velocityInput?.value.trim() === '' ? null : Number(velocityInput?.value);
        const normalizedVelocity = rawVelocity !== null && Number.isFinite(rawVelocity) ? rawVelocity : null;
        const potentialDecrease = heightM === null ? null : massKg * gravity * heightM;
        const kineticIncrease = normalizedVelocity === null ? null : 0.5 * massKg * normalizedVelocity ** 2;
        const relativeError =
          potentialDecrease !== null && kineticIncrease !== null && kineticIncrease !== 0
            ? Math.abs(1 - potentialDecrease / kineticIncrease)
            : null;

        return {
          point,
          heightCm,
          heightM,
          velocity: normalizedVelocity,
          potentialDecrease,
          kineticIncrease,
          relativeError,
          chartReady: nonZeroPoints.includes(point) && potentialDecrease !== null && kineticIncrease !== null
        };
      });

      return rows;
    };

    const getChartPoints = (rows: RampRow[]) =>
      rows
        .filter((row): row is RampRow & { potentialDecrease: number; kineticIncrease: number } => row.chartReady)
        .map((row) => ({
          point: row.point,
          potentialDecrease: row.potentialDecrease,
          kineticIncrease: row.kineticIncrease,
          relativeError: row.relativeError
        }));

    const drawEnergyBarChart = (points: ChartPoint[]) => {
      if (!barChart) return;
      chartHitAreas = [];
      const ratio = window.devicePixelRatio || 1;
      const rect = barChart.getBoundingClientRect();
      const width = Math.max(1, Math.floor(rect.width * ratio));
      const height = Math.max(1, Math.floor(rect.height * ratio));
      barChart.width = width;
      barChart.height = height;

      const ctx = barChart.getContext('2d');
      if (!ctx) return;

      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, width, height);

      const marginLeft = 72 * ratio;
      const marginRight = 34 * ratio;
      const marginTop = 62 * ratio;
      const marginBottom = 68 * ratio;
      const plotWidth = width - marginLeft - marginRight;
      const plotHeight = height - marginTop - marginBottom;
      const originX = marginLeft;
      const originY = height - marginBottom;
      const maxValue = Math.max(0.01, ...points.flatMap((point) => [point.potentialDecrease, point.kineticIncrease])) * 1.32;

      ctx.strokeStyle = 'rgba(219, 234, 254, 0.16)';
      ctx.lineWidth = 1 * ratio;
      ctx.fillStyle = '#dbeafe';
      ctx.font = `${11 * ratio}px system-ui, sans-serif`;
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      for (let i = 0; i <= 5; i += 1) {
        const value = (maxValue * i) / 5;
        const y = originY - (plotHeight * i) / 5;
        ctx.beginPath();
        ctx.moveTo(originX, y);
        ctx.lineTo(originX + plotWidth, y);
        ctx.stroke();
        ctx.fillText(value.toFixed(3), originX - 10 * ratio, y);
      }

      ctx.strokeStyle = 'rgba(255,255,255,0.82)';
      ctx.lineWidth = 1.6 * ratio;
      ctx.beginPath();
      ctx.moveTo(originX, marginTop);
      ctx.lineTo(originX, originY);
      ctx.lineTo(originX + plotWidth, originY);
      ctx.stroke();

      ctx.fillStyle = '#dbeafe';
      ctx.font = `${13 * ratio}px system-ui, sans-serif`;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('能量变化 / J', originX, marginTop - 28 * ratio);
      ctx.textAlign = 'center';
      ctx.fillText('测量点', originX + plotWidth / 2, height - 18 * ratio);

      ctx.textAlign = 'left';
      ctx.fillStyle = '#fbbf24';
      ctx.fillRect(originX + plotWidth - 212 * ratio, marginTop - 36 * ratio, 12 * ratio, 12 * ratio);
      ctx.fillStyle = '#dbeafe';
      ctx.fillText('势能减小 mgΔh', originX + plotWidth - 194 * ratio, marginTop - 25 * ratio);
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(originX + plotWidth - 96 * ratio, marginTop - 36 * ratio, 12 * ratio, 12 * ratio);
      ctx.fillStyle = '#dbeafe';
      ctx.fillText('动能增加 ΔEk', originX + plotWidth - 78 * ratio, marginTop - 25 * ratio);

      if (!points.length) return;

      const groupWidth = plotWidth / points.length;
      const barWidth = Math.min(42 * ratio, groupWidth * 0.24);
      const hitPadding = 8 * ratio;
      ctx.textBaseline = 'alphabetic';

      points.forEach((point, order) => {
        const groupCenter = originX + groupWidth * (order + 0.5);
        const potentialHeight = (point.potentialDecrease / maxValue) * plotHeight;
        const kineticHeight = (point.kineticIncrease / maxValue) * plotHeight;
        const potentialX = groupCenter - barWidth - 5 * ratio;
        const kineticX = groupCenter + 5 * ratio;

        ctx.fillStyle = '#fbbf24';
        ctx.fillRect(potentialX, originY - potentialHeight, barWidth, potentialHeight);
        ctx.fillStyle = '#38bdf8';
        ctx.fillRect(kineticX, originY - kineticHeight, barWidth, kineticHeight);

        chartHitAreas.push(
          {
            x: (potentialX - hitPadding) / ratio,
            y: marginTop / ratio,
            width: (barWidth + hitPadding * 2) / ratio,
            height: (originY - marginTop) / ratio,
            kind: 'potential',
            point,
            label: '势能减小 mgΔh',
            value: point.potentialDecrease
          },
          {
            x: (kineticX - hitPadding) / ratio,
            y: marginTop / ratio,
            width: (barWidth + hitPadding * 2) / ratio,
            height: (originY - marginTop) / ratio,
            kind: 'kinetic',
            point,
            label: '动能增加 1/2mv² - 0',
            value: point.kineticIncrease
          }
        );

        const selectedKind = activeChartSelection?.point === point.point ? activeChartSelection.kind : null;
        if (selectedKind) {
          const selectedArea = selectedKind === 'potential'
            ? { x: potentialX, height: potentialHeight, color: '#fde68a' }
            : { x: kineticX, height: kineticHeight, color: '#bae6fd' };
          ctx.strokeStyle = selectedArea.color;
          ctx.lineWidth = 2 * ratio;
          ctx.strokeRect(selectedArea.x - 2 * ratio, originY - selectedArea.height - 2 * ratio, barWidth + 4 * ratio, selectedArea.height + 4 * ratio);
        }

        ctx.fillStyle = '#dbeafe';
        ctx.font = `${13 * ratio}px system-ui, sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillText(pointLabels[point.point], groupCenter, originY + 25 * ratio);

      });
    };

    const padNumber = (value: number, size = 2) => String(value).padStart(size, '0');

    const formatOnlineTimestamp = (timeMs: number) => {
      const date = new Date(timeMs);
      return [
        `${date.getFullYear()}-${padNumber(date.getMonth() + 1)}-${padNumber(date.getDate())}`,
        `${padNumber(date.getHours())}:${padNumber(date.getMinutes())}:${padNumber(date.getSeconds())}.${padNumber(date.getMilliseconds(), 3)}`
      ].join(' ');
    };

    const drawVelocityChart = () => {
      if (!velocityChart) return;
      const ratio = window.devicePixelRatio || 1;
      const rect = velocityChart.getBoundingClientRect();
      const width = Math.max(1, Math.floor(rect.width * ratio));
      const height = Math.max(1, Math.floor(rect.height * ratio));
      velocityChart.width = width;
      velocityChart.height = height;

      const ctx = velocityChart.getContext('2d');
      if (!ctx) return;

      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, width, height);

      const padding = {
        top: 34 * ratio,
        right: 34 * ratio,
        bottom: 64 * ratio,
        left: 78 * ratio
      };
      const plotLeft = padding.left;
      const plotTop = padding.top;
      const plotWidth = Math.max(1, width - padding.left - padding.right);
      const plotHeight = Math.max(1, height - padding.top - padding.bottom);
      const plotBottom = plotTop + plotHeight;
      const visible = velocityRecords.slice(-24);
      const maxVelocity = Math.max(1, ...visible.map((record) => record.velocity)) * 1.18;

      ctx.strokeStyle = 'rgba(219, 234, 254, 0.16)';
      ctx.lineWidth = 1 * ratio;
      ctx.fillStyle = '#cbd5e1';
      ctx.font = `${12 * ratio}px system-ui, sans-serif`;
      ctx.textBaseline = 'middle';
      for (let i = 0; i <= 5; i += 1) {
        const y = plotTop + (plotHeight / 5) * i;
        const value = maxVelocity - (maxVelocity / 5) * i;
        ctx.beginPath();
        ctx.moveTo(plotLeft, y);
        ctx.lineTo(plotLeft + plotWidth, y);
        ctx.stroke();
        ctx.textAlign = 'right';
        ctx.fillText(value.toFixed(2), plotLeft - 12 * ratio, y);
      }

      ctx.strokeStyle = 'rgba(226, 232, 240, 0.75)';
      ctx.lineWidth = 1.6 * ratio;
      ctx.beginPath();
      ctx.moveTo(plotLeft, plotTop);
      ctx.lineTo(plotLeft, plotBottom);
      ctx.lineTo(plotLeft + plotWidth, plotBottom);
      ctx.stroke();

      ctx.fillStyle = '#dbeafe';
      ctx.font = `${14 * ratio}px system-ui, sans-serif`;
      ctx.textAlign = 'center';
      ctx.fillText('测量序号', plotLeft + plotWidth / 2, height - 22 * ratio);
      ctx.save();
      ctx.translate(22 * ratio, plotTop + plotHeight / 2);
      ctx.rotate(-Math.PI / 2);
      ctx.fillText('速度 / m/s', 0, 0);
      ctx.restore();

      if (!visible.length) {
        ctx.fillStyle = 'rgba(226, 232, 240, 0.82)';
        ctx.font = `${16 * ratio}px system-ui, sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillText('等待 ESP32-gate 光电门速度数据', plotLeft + plotWidth / 2, plotTop + plotHeight / 2);
        return;
      }

      const slotWidth = plotWidth / visible.length;
      const barWidth = Math.max(12 * ratio, Math.min(34 * ratio, slotWidth * 0.55));
      visible.forEach((record, index) => {
        const xCenter = plotLeft + slotWidth * (index + 0.5);
        const barHeight = Math.max(2 * ratio, (record.velocity / maxVelocity) * plotHeight);
        const x = xCenter - barWidth / 2;
        const y = plotBottom - barHeight;
        const latest = index === visible.length - 1;
        ctx.fillStyle = latest ? '#f4a51c' : '#4ba6ff';
        ctx.fillRect(x, y, barWidth, barHeight);

        ctx.fillStyle = 'rgba(226, 232, 240, 0.78)';
        ctx.font = `${11 * ratio}px system-ui, sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillText(String(record.id), xCenter, plotBottom + 20 * ratio);
      });
    };

    const renderVelocityRecords = () => {
      drawVelocityChart();
      if (!velocityRecordTableBody) return;

      if (!velocityRecords.length) {
        velocityRecordTableBody.innerHTML = '<tr><td class="px-4 py-4 text-slate-500" colspan="7">等待双头光电门触发</td></tr>';
        return;
      }

      velocityRecordTableBody.innerHTML = velocityRecords
        .slice()
        .reverse()
        .map((record) => `
          <tr>
            <td class="px-4 py-3 font-bold text-ink">${record.id}</td>
            <td class="px-4 py-3">${record.source}</td>
            <td class="px-4 py-3 font-mono">${formatOnlineTimestamp(record.onlineTimeMs)}</td>
            <td class="px-4 py-3 font-mono">${record.deviceTime === undefined ? '--' : record.deviceTime.toFixed(3)}</td>
            <td class="px-4 py-3 font-mono">${record.gateDeltaUs === undefined ? '--' : record.gateDeltaUs.toFixed(0)}</td>
            <td class="px-4 py-3 font-mono font-bold text-yucai-800">${record.velocity.toFixed(4)}</td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-2">
                ${nonZeroPoints.map((point) => `<button class="focus-ring rounded-md border border-yucai-600 px-2 py-1 text-xs font-bold text-yucai-700 transition hover:bg-yucai-50" data-fill-point="${point}" data-record-id="${record.id}" type="button">填入 ${pointLabels[point]}</button>`).join('')}
              </div>
            </td>
          </tr>
        `)
        .join('');
    };

    const appendVelocityRecord = (velocity: number, meta: CapturedVelocityMeta) => {
      if (!Number.isFinite(velocity) || velocity < 0) return;
      velocityRecordSequence += 1;
      latestVelocity = velocity;
      velocityRecords.push({
        id: velocityRecordSequence,
        velocity,
        onlineTimeMs: Date.now(),
        ...meta
      });
      if (velocityRecords.length > 200) velocityRecords.shift();
      renderVelocityRecords();

      const detailParts = [
        meta.deviceTime !== undefined ? `设备时间 ${meta.deviceTime.toFixed(3)} s` : '',
        meta.gateDeltaUs !== undefined ? `两门时间差 ${meta.gateDeltaUs.toFixed(0)} us` : ''
      ].filter(Boolean);
      setMode(meta.source === '串口' ? 'serial' : 'ble', `${meta.source}已记录速度 ${velocity.toFixed(4)} m/s${detailParts.length ? `，${detailParts.join('，')}` : ''}`);
      render();
    };

    const fillVelocityRecordToPoint = (recordId: number, point: RampPointKey) => {
      const record = velocityRecords.find((item) => item.id === recordId);
      if (!record || !nonZeroPoints.includes(point)) return;
      const input = getInputByPoint(velocityInputs, point);
      if (!input) return;
      input.value = record.velocity.toFixed(4);
      latestVelocity = record.velocity;
      setInputStatus(`已将第 ${record.id} 次速度 ${record.velocity.toFixed(4)} m/s 填入 ${pointLabels[point]}`);
      render();
    };

    const getCurrentChartPoints = () => getChartPoints(readRows());

    const hideEnergyTooltip = () => {
      if (!energyTooltip) return;
      energyTooltip.classList.add('hidden');
      energyTooltip.textContent = '';
    };

    const findChartHitArea = (event: MouseEvent) => {
      if (!barChart) return null;
      const rect = barChart.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      return chartHitAreas.find((area) =>
        x >= area.x &&
        x <= area.x + area.width &&
        y >= area.y &&
        y <= area.y + area.height
      ) || null;
    };

    const showEnergyTooltip = (area: ChartHitArea, event: MouseEvent) => {
      if (!energyTooltip || !barChart?.parentElement) return;
      const containerRect = barChart.parentElement.getBoundingClientRect();
      const tooltipWidth = 224;
      const left = Math.min(Math.max(event.clientX - containerRect.left + 14, 12), containerRect.width - tooltipWidth - 12);
      const top = Math.min(Math.max(event.clientY - containerRect.top - 18, 12), containerRect.height - 116);
      energyTooltip.style.left = `${left}px`;
      energyTooltip.style.top = `${top}px`;
      energyTooltip.innerHTML = `
        <p class="font-bold text-white">${pointLabels[area.point.point]} ${area.label}</p>
        <p><span class="text-blue-200">当前柱：</span><span class="font-mono font-bold">${formatEnergyValue(area.value)}</span></p>
        <p><span class="text-amber-200">势能减小：</span><span class="font-mono">${formatEnergyValue(area.point.potentialDecrease)}</span></p>
        <p><span class="text-sky-200">动能增加：</span><span class="font-mono">${formatEnergyValue(area.point.kineticIncrease)}</span></p>
      `;
      energyTooltip.classList.remove('hidden');
    };

    const handleChartPointer = (event: MouseEvent) => {
      const area = findChartHitArea(event);
      if (!area) {
        activeChartSelection = null;
        hideEnergyTooltip();
        drawEnergyBarChart(getCurrentChartPoints());
        return;
      }

      activeChartSelection = { point: area.point.point, kind: area.kind };
      drawEnergyBarChart(getCurrentChartPoints());
      showEnergyTooltip(area, event);
    };

    const updateSummary = (points: ChartPoint[]) => {
      if (pointCountLabel) pointCountLabel.textContent = String(points.length);
      if (latestVelocityLabel) latestVelocityLabel.textContent = latestVelocity === null ? '--' : `${latestVelocity.toFixed(4)} m/s`;
    };

    const render = () => {
      const rows = readRows();
      for (const row of rows) {
        setCell(row.point, 'potential', formatNumber(row.potentialDecrease));
        setCell(row.point, 'kinetic', formatNumber(row.kineticIncrease));
      }

      const points = getChartPoints(rows);
      if (activeChartSelection && !points.some((point) => point.point === activeChartSelection?.point)) {
        activeChartSelection = null;
        hideEnergyTooltip();
      }
      if (barChartEmpty) {
        barChartEmpty.textContent = points.length ? '' : '请至少填写一个测量点';
      }
      drawEnergyBarChart(points);
      updateSummary(points);
      return { rows, points };
    };

    const setInputStatus = (text: string) => {
      if (inputStatus) inputStatus.textContent = text;
    };

    const modeButtonBaseClass = 'focus-ring h-11 rounded-md border px-4 text-sm font-bold transition';
    const modeButtonActiveClass = `${modeButtonBaseClass} border-yucai-600 bg-yucai-700 text-white hover:bg-yucai-800`;
    const modeButtonInactiveClass = `${modeButtonBaseClass} border-slate-300 text-slate-700 hover:bg-slate-100`;

    const styleModeButton = (button: HTMLButtonElement | null, active: boolean) => {
      if (!button) return;
      button.className = active ? modeButtonActiveClass : modeButtonInactiveClass;
    };

    const setMode = (mode: InputMode, statusText?: string) => {
      currentMode = mode;
      if (serialPanel) serialPanel.classList.toggle('hidden', mode !== 'serial');
      if (blePanel) blePanel.classList.toggle('hidden', mode !== 'ble');
      if (velocityRecordPanel) velocityRecordPanel.classList.toggle('hidden', mode === 'manual');

      styleModeButton(manualButton, mode === 'manual');
      styleModeButton(serialModeButton, mode === 'serial');
      styleModeButton(bleModeButton, mode === 'ble');

      const text = mode === 'manual' ? '手动录入' : mode === 'serial' ? '串口输入' : '蓝牙输入';
      if (modeLabel) modeLabel.textContent = text;
      setInputStatus(statusText || `当前为${text}`);
      renderVelocityRecords();
    };

    const generateSimulatedData = () => {
      for (const point of pointOrder) {
        const heightInput = getInputByPoint(heightInputs, point);
        const velocityInput = getInputByPoint(velocityInputs, point);
        if (heightInput) heightInput.value = simulatedData[point].heightCm.toFixed(2);
        if (velocityInput) velocityInput.value = simulatedData[point].velocity.toFixed(4);
      }
      latestVelocity = simulatedData.A.velocity;
      setMode('manual', '已填入 AI 模拟数据');
      render();
    };

    const clearData = () => {
      for (const point of pointOrder) {
        const heightInput = getInputByPoint(heightInputs, point);
        const velocityInput = getInputByPoint(velocityInputs, point);
        if (heightInput) heightInput.value = '';
        if (velocityInput) velocityInput.value = '';
      }
      latestVelocity = null;
      velocityRecords.length = 0;
      velocityRecordSequence = 0;
      activeChartSelection = null;
      hideEnergyTooltip();
      setMode('manual', '数据已清空');
      render();
    };

    const appendSerialLog = (line: string) => {
      if (!serialLog) return;
      const previous = serialLog.textContent === '等待串口数据...' ? '' : serialLog.textContent ?? '';
      serialLog.textContent = `${previous}${previous ? '\n' : ''}${line}`;
      if (serialLog.textContent.length > maxLogLength) {
        serialLog.textContent = serialLog.textContent.slice(-maxLogLength);
      }
      serialLog.scrollTop = serialLog.scrollHeight;
    };

    const parseSerialPhotogateLine = (line: string) => {
      const numberPattern = '([+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)';
      const velocityMatch = line.match(new RegExp(`速度是\\s*${numberPattern}\\s*m/s`));
      if (!velocityMatch) return null;

      const timeMatch = line.match(new RegExp(`时间是\\s*${numberPattern}\\s*s`));
      const deltaMatch = line.match(new RegExp(`两门时间差是\\s*${numberPattern}\\s*us`));
      const velocity = Number(velocityMatch[1]);
      const deviceTime = timeMatch ? Number(timeMatch[1]) : undefined;
      const gateDeltaUs = deltaMatch ? Number(deltaMatch[1]) : undefined;
      if (!Number.isFinite(velocity)) return null;

      return {
        velocity,
        deviceTime: Number.isFinite(deviceTime) ? deviceTime : undefined,
        gateDeltaUs: Number.isFinite(gateDeltaUs) ? gateDeltaUs : undefined
      };
    };

    const handleSerialText = (text: string) => {
      const cleaned = text.replace(/\x04/g, '');
      if (!cleaned) return;
      serialLineBuffer += cleaned;
      const lines = serialLineBuffer.split(/\r?\n/);
      serialLineBuffer = lines.pop() ?? '';

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        appendSerialLog(trimmed);
        const parsed = parseSerialPhotogateLine(trimmed);
        if (parsed) {
          appendVelocityRecord(parsed.velocity, {
            source: '串口',
            deviceTime: parsed.deviceTime,
            gateDeltaUs: parsed.gateDeltaUs,
            raw: trimmed
          });
        }
      }
    };

    const startSerialReadLoop = () => {
      if (!serialReader || serialReadLoopStarted) return;
      serialReadLoopStarted = true;
      const loop = async () => {
        while (serialReader) {
          try {
            const { value, done } = await serialReader.read();
            if (done) break;
            if (!value) continue;
            handleSerialText(decoder.decode(value, { stream: true }));
          } catch (error) {
            appendSerialLog(`串口读取已停止：${error instanceof Error ? error.message : String(error)}`);
            break;
          }
        }
        serialReadLoopStarted = false;
      };
      void loop();
    };

    const connectSerial = async () => {
      const serialNavigator = navigator as SerialNavigator;
      if (!serialNavigator.serial) {
        setMode('serial', '当前浏览器不支持 Web Serial，请使用电脑端 Chrome 或 Edge');
        appendSerialLog('当前浏览器不支持 Web Serial。');
        return;
      }

      try {
        if (!serialPort) {
          serialPort = await serialNavigator.serial.requestPort();
          await serialPort.open({ baudRate: 115200 });
        }

        if (!serialPort.readable || !serialPort.writable) {
          throw new Error('串口读写流不可用');
        }

        serialReader = serialPort.readable.getReader();
        startSerialReadLoop();
        if (serialConnectButton) serialConnectButton.textContent = '已连接串口';
        setMode('serial', '串口已打开，等待双头光电门速度数据');
        appendSerialLog('串口已打开，波特率 115200。');
      } catch (error) {
        console.error('[Curved Ramp Lab] 串口连接失败', error);
        setMode('serial', `串口连接失败：${error instanceof Error ? error.message : String(error)}`);
      }
    };

    const getBleNamePrefix = () => bleNamePrefixInput?.value.trim() || 'ESP32-gate';

    const requestAllBluetoothDevices = (bluetooth: BluetoothLike) =>
      bluetooth.requestDevice({
        acceptAllDevices: true,
        optionalServices: phyphoxServiceUuids
      });

    const requestNamedBluetoothDevice = (bluetooth: BluetoothLike) =>
      bluetooth.requestDevice({
        filters: [{ namePrefix: getBleNamePrefix() }],
        optionalServices: [phyphoxDataServiceUuid]
      });

    const disconnectCurrentBleDevice = () => {
      if (bleDataCharacteristic) {
        bleDataCharacteristic.removeEventListener('characteristicvaluechanged', handleBleNotification);
        bleDataCharacteristic = null;
      }

      if (selectedBleDevice?.gatt?.connected) {
        selectedBleDevice.gatt.disconnect();
      }

      selectedBleDevice = null;
      bleDeviceName = '';
    };

    const parseBlePacket = (value: DataView) => {
      if (value.byteLength < 8) return null;
      const velocity = value.getFloat32(0, true);
      const deviceTime = value.getFloat32(4, true);
      if (!Number.isFinite(velocity) || !Number.isFinite(deviceTime)) return null;
      return { velocity, deviceTime };
    };

    function handleBleNotification(event: Event) {
      const value = (event.target as BluetoothRemoteGATTCharacteristicLike | null)?.value;
      if (!value) return;
      const parsed = parseBlePacket(value);
      if (!parsed) {
        if (bleStatus) bleStatus.textContent = `已连接 ${bleDeviceName}，收到 ${value.byteLength} 字节，等待 8 字节速度数据包`;
        return;
      }

      if (bleStatus) bleStatus.textContent = `已连接 ${bleDeviceName}，速度 ${parsed.velocity.toFixed(4)} m/s，设备时间 ${parsed.deviceTime.toFixed(3)} s`;
      appendVelocityRecord(parsed.velocity, {
        source: '蓝牙',
        deviceTime: parsed.deviceTime
      });
    }

    const connectBleDataProbe = async (device: BluetoothDeviceLike, deviceName: string) => {
      if (!device.gatt) throw new Error('设备不支持 GATT 连接');

      const server = await device.gatt.connect();
      const service = await server.getPrimaryService(phyphoxDataServiceUuid);
      const characteristic = await service.getCharacteristic(phyphoxDataCharacteristicUuid);

      if (bleDataCharacteristic) {
        bleDataCharacteristic.removeEventListener('characteristicvaluechanged', handleBleNotification);
      }

      bleDeviceName = deviceName;
      selectedBleDevice = device;
      bleDataCharacteristic = characteristic;
      characteristic.addEventListener('characteristicvaluechanged', handleBleNotification);
      await characteristic.startNotifications();
    };

    const connectBluetooth = async (requestDevice: (bluetooth: BluetoothLike) => Promise<BluetoothDeviceLike>, searchText: string) => {
      const bluetoothNavigator = navigator as Navigator & { bluetooth?: BluetoothLike };

      if (!bluetoothNavigator.bluetooth) {
        if (bleStatus) bleStatus.textContent = '当前浏览器不支持 Web Bluetooth，无法接收真实双头光电门数据';
        setMode('ble', '当前浏览器不支持 Web Bluetooth');
        return;
      }

      try {
        disconnectCurrentBleDevice();
        if (bleStatus) bleStatus.textContent = searchText;
        setMode('ble', searchText);
        const device = await requestDevice(bluetoothNavigator.bluetooth);
        const deviceName = device.name?.trim() || '未命名设备';
        if (bleStatus) bleStatus.textContent = `已选择蓝牙设备：${deviceName}，正在连接 GATT...`;
        await connectBleDataProbe(device, deviceName);
        if (bleStatus) bleStatus.textContent = `已连接 ${deviceName}，等待速度和设备时间数据`;
        setMode('ble', `已连接 ${deviceName}，等待速度和设备时间数据`);
      } catch (error) {
        console.error('[Curved Ramp Lab] 蓝牙连接失败', error);
        if (error instanceof DOMException && error.name === 'NotFoundError') {
          if (bleStatus) bleStatus.textContent = '未选择蓝牙设备';
          setMode('ble', '未选择蓝牙设备');
          return;
        }
        if (bleStatus) bleStatus.textContent = '蓝牙连接或订阅失败，无法接收真实双头光电门数据';
        setMode('ble', '蓝牙连接或订阅失败');
      }
    };

    const csvEscape = (value: string | number | null) => `"${String(value ?? '').replaceAll('"', '""')}"`;

    const buildCsv = (rows: RampRow[]) => {
      const massG = getPositiveNumericValue(massInput, 100);
      const gravity = getPositiveNumericValue(gravityInput, 9.788);
      const diameter = getNumericValue(cylinderDiameterInput, 0);
      const lines: Array<Array<string | number | null>> = [
        ['实验小组名称', readGroupName()],
        ['实验名称', '沿曲线运动验证机械能守恒定律'],
        ['金属圆柱体质量 m / g', massG.toFixed(1)],
        ['重力加速度 g / (m/s²)', gravity.toFixed(4)],
        ['金属圆柱体直径 d / cm（记录）', diameter.toFixed(4)],
        [],
        ['测量点', '相对D的高度 h / cm', '到达D的速度 v / (m/s)', '重力势能减少量 ΔEp / J', '动能增加量 ΔEk / J']
      ];

      for (const row of rows) {
        lines.push([
          pointLabels[row.point],
          formatNumber(row.heightCm),
          formatNumber(row.velocity),
          formatNumber(row.potentialDecrease),
          formatNumber(row.kineticIncrease)
        ]);
      }

      return `\uFEFF${lines.map((line) => line.map(csvEscape).join(',')).join('\n')}`;
    };

    const sanitizeFileName = (value: string) => value.replace(/[\\/:*?"<>|]/g, '-').replace(/\s+/g, '-').slice(0, 40) || '未命名小组';

    const downloadBlob = (blob: Blob, filename: string) => {
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    };

    const timestamp = () => new Date().toISOString().replace(/[:.]/g, '-');

    const exportCsv = () => {
      const { rows } = render();
      const csv = buildCsv(rows);
      const filename = `沿曲线运动机械能守恒-${sanitizeFileName(readGroupName())}-数据-${timestamp()}.csv`;
      downloadBlob(new Blob([csv], { type: 'text/csv;charset=utf-8' }), filename);
    };

    const exportScreenshot = () => {
      const { rows, points } = render();
      const ratio = window.devicePixelRatio || 1;
      const width = 1200;
      const rowHeight = 38;
      const height = 740 + rows.length * rowHeight;
      const reportCanvas = document.createElement('canvas');
      reportCanvas.width = width * ratio;
      reportCanvas.height = height * ratio;
      const ctx = reportCanvas.getContext('2d');
      if (!ctx) return;
      ctx.scale(ratio, ratio);

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);
      ctx.fillStyle = '#0f172a';
      ctx.font = '700 30px system-ui, sans-serif';
      ctx.fillText('沿曲线运动验证机械能守恒定律', 48, 58);
      ctx.font = '600 17px system-ui, sans-serif';
      ctx.fillStyle = '#0f5ca8';
      ctx.fillText(`实验小组名称：${readGroupName()}`, 48, 92);
      ctx.fillStyle = '#475569';
      ctx.fillText(
        `m=${getPositiveNumericValue(massInput, 100).toFixed(1)} g    g=${getPositiveNumericValue(gravityInput, 9.788).toFixed(4)} m/s²    d=${getNumericValue(cylinderDiameterInput, 0).toFixed(4)} cm`,
        48,
        122
      );

      if (barChart) {
        ctx.drawImage(barChart, 48, 150, 1104, 360);
      }

      ctx.fillStyle = '#0f172a';
      ctx.font = '700 18px system-ui, sans-serif';
      ctx.fillText(`可绘图点：${points.length}`, 48, 540);

      const headers = ['点', 'h / cm', 'v / (m/s)', 'ΔEp / J', 'ΔEk / J'];
      const widths = [110, 130, 175, 175, 175];
      let x = 48;
      let y = 576;
      ctx.fillStyle = '#eaf5ff';
      ctx.fillRect(48, y - 24, 1104, 36);
      ctx.fillStyle = '#0f172a';
      ctx.font = '700 14px system-ui, sans-serif';
      headers.forEach((header, index) => {
        ctx.fillText(header, x + 8, y);
        x += widths[index];
      });

      ctx.font = '500 13px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace';
      rows.forEach((row, rowIndex) => {
        x = 48;
        y = 614 + rowIndex * rowHeight;
        ctx.fillStyle = rowIndex % 2 === 0 ? '#ffffff' : '#f8fafc';
        ctx.fillRect(48, y - 24, 1104, rowHeight);
        ctx.fillStyle = '#0f172a';
        const values = [
          pointLabels[row.point],
          formatNumber(row.heightCm),
          formatNumber(row.velocity),
          formatNumber(row.potentialDecrease),
          formatNumber(row.kineticIncrease)
        ];
        values.forEach((value, index) => {
          ctx.fillText(String(value), x + 8, y);
          x += widths[index];
        });
      });

      const filename = `沿曲线运动机械能守恒-${sanitizeFileName(readGroupName())}-截图-${timestamp()}.png`;
      reportCanvas.toBlob((blob) => {
        if (blob) downloadBlob(blob, filename);
      }, 'image/png');
      reportCanvas.toDataURL('image/png');
    };

    for (const input of [...heightInputs, ...velocityInputs, massInput, gravityInput, cylinderDiameterInput]) {
      input?.addEventListener('input', () => {
        if (currentMode !== 'manual') setInputStatus('已手动修改数据');
        render();
      });
    }

    manualButton?.addEventListener('click', () => setMode('manual'));
    serialModeButton?.addEventListener('click', () => setMode('serial', '串口输入已就绪，请连接 ESP32 双头光电门'));
    bleModeButton?.addEventListener('click', () => setMode('ble', '蓝牙输入已就绪，请连接 ESP32-gate 双头光电门'));
    simulateButton?.addEventListener('click', generateSimulatedData);
    clearButton?.addEventListener('click', clearData);
    clearVelocityRecordsButton?.addEventListener('click', () => {
      velocityRecords.length = 0;
      velocityRecordSequence = 0;
      latestVelocity = null;
      renderVelocityRecords();
      render();
      setInputStatus('速度记录已清空');
    });
    exportCsvButton?.addEventListener('click', exportCsv);
    exportScreenshotButton?.addEventListener('click', exportScreenshot);
    serialConnectButton?.addEventListener('click', connectSerial);
    serialClearLogButton?.addEventListener('click', () => {
      if (serialLog) serialLog.textContent = '等待串口数据...';
    });
    bleConnectPrefixButton?.addEventListener('click', () => {
      void connectBluetooth(requestNamedBluetoothDevice, `正在查找名称以 ${getBleNamePrefix()} 开头的双头光电门...`);
    });
    bleConnectAllButton?.addEventListener('click', () => {
      void connectBluetooth(requestAllBluetoothDevices, '正在显示所有可见的 BLE 设备，请选择 ESP32 双头光电门...');
    });
    bleNamePrefixInput?.addEventListener('input', () => {
      if (bleStatus) bleStatus.textContent = `等待连接 ${getBleNamePrefix()} 双头光电门`;
    });
    velocityRecordTableBody?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest<HTMLButtonElement>('[data-fill-point][data-record-id]');
      if (!button) return;
      const point = button.dataset.fillPoint as RampPointKey | undefined;
      const recordId = Number(button.dataset.recordId);
      if (!point || !Number.isFinite(recordId)) return;
      fillVelocityRecordToPoint(recordId, point);
    });
    if (barChart) {
      barChart.addEventListener('mousemove', handleChartPointer);
      barChart.addEventListener('click', handleChartPointer);
      barChart.addEventListener('mouseleave', () => {
        activeChartSelection = null;
        hideEnergyTooltip();
        drawEnergyBarChart(getCurrentChartPoints());
      });
    }
    window.addEventListener('resize', () => {
      render();
      renderVelocityRecords();
    });
    setMode('manual');
    render();
    bindLabDraft({
      experiment: 'curved-ramp',
      fields: {
        group: groupNameInput, mass: massInput, gravity: gravityInput, diameter: cylinderDiameterInput,
        ...Object.fromEntries(heightInputs.map(input => [`height-${input.dataset.point}`, input])),
        ...Object.fromEntries(velocityInputs.map(input => [`velocity-${input.dataset.point}`, input]))
      },
      onRestore: () => { render(); }
    });
  </script>
</section>

