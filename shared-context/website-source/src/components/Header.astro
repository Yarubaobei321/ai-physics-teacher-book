---
import { site } from '../data/site';
const pathname = Astro.url.pathname;
const section = ['/dis/', '/programming/', '/photogate-comparison/'].includes(pathname) ? '/online-lab/' : pathname.startsWith('/projects/') ? '/maker/' : pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : section.startsWith(href);
---
<header class="site-header">
  <div class="page-shell site-header-row">
    <a href="/" class="focus-ring site-brand" aria-label="返回首页">
      <picture><source srcset="/logo-web.webp" type="image/webp" /><img src="/logo-web.png" alt="" width="40" height="40" /></picture>
      <span>{site.name}</span>
    </a>
    <nav class="site-desktop-nav" aria-label="主导航">
      {site.nav.map(item => <a class:list={['focus-ring', { active: isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
      <a class="focus-ring site-resource-link" href="/resources/" aria-current={pathname === "/resources/" ? "page" : undefined} aria-label="查找教学资源" title="查找教学资源"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.8"/></svg></a>
    </nav>
    <details class="site-mobile-menu" id="site-mobile-menu">
      <summary class="focus-ring">导航 <span aria-hidden="true">☰</span></summary>
      <nav aria-label="移动端主导航">
        {site.nav.map(item => <a class:list={['focus-ring', { active: isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
        <a class="focus-ring" href="/resources/">查找资源 ↗</a>
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid #e2e8f0}
  .site-header-row{height:64px;display:flex;align-items:center;justify-content:space-between;gap:20px;position:relative}
  .site-brand{display:flex;align-items:center;gap:12px;min-width:0;border-radius:6px;text-decoration:none;color:#102033;font-weight:700;font-size:17px}
  .site-brand img{width:40px;height:40px;object-fit:contain;display:block}
  .site-brand span{white-space:nowrap}
  .site-desktop-nav{display:flex;align-items:center;gap:4px}
  nav a{color:#334155;font-weight:600;font-size:14px;text-decoration:none;border-radius:6px;padding:10px 12px;min-height:44px;display:flex;align-items:center}
  nav a:hover{color:#074f9f;background:#f5f8fb}
  nav a.active{background:#eef7ff;color:#074f9f}
  .site-resource-link{margin-left:8px}
  .site-mobile-menu{display:none}
  @media(max-width:1023px){
    .site-header-row{height:64px;gap:12px}.site-brand{font-size:15px;gap:8px}.site-brand img{width:34px;height:34px}.site-desktop-nav{display:none}.site-mobile-menu{display:block;flex-shrink:0}
    summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;border:1px solid #cbd5e1;border-radius:6px;padding:10px 12px;min-height:44px;color:#102033}
    summary::-webkit-details-marker{display:none}summary::marker{content:''}
    .site-mobile-menu[open] summary{background:#eef7ff;border-color:#85c6ff}
    .site-mobile-menu nav{position:absolute;top:64px;left:-16px;right:-16px;padding:12px 16px 20px;background:white;border-bottom:1px solid #e2e8f0;box-shadow:0 16px 28px #10203312;display:grid;grid-template-columns:1fr 1fr;gap:4px}
  }
  @media(max-width:350px){.site-brand{font-size:13px;gap:6px}.site-brand img{width:28px;height:28px}summary{padding:10px}}
</style>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('#site-mobile-menu');
  const close = (focus = false) => { if (menu?.open) { menu.open = false; if (focus) menu.querySelector('summary')?.focus(); } };
  menu?.querySelector('nav')?.addEventListener('click', event => { if ((event.target as HTMLElement).closest('a')) close(); });
  document.addEventListener('click', event => { if (event.target instanceof Node && !menu?.contains(event.target)) close(); });
  document.addEventListener('keydown', event => { if (event.key === 'Escape') close(true); });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => { if (event.matches) close(); });
</script>
