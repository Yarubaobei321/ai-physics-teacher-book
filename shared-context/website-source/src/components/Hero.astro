---
import { site } from '../data/site';
---

<section class="relative min-h-[calc(100svh-6.5rem)] overflow-hidden bg-ink text-white sm:min-h-[calc(100svh-4rem)]">
  <picture>
    <source srcset="/campus.webp" type="image/webp" />
    <img
      src="/campus.jpeg"
      alt="育才校园"
      width="1000"
      height="562"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </picture>
  <div class="absolute inset-0 bg-yucai-900/72"></div>
  <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,32,51,0.9)_0%,rgba(11,99,199,0.72)_46%,rgba(16,32,51,0.18)_100%)]"></div>
  <div class="page-shell relative flex min-h-[calc(100svh-6.5rem)] items-center py-14 sm:min-h-[calc(100svh-4rem)]">
    <div class="max-w-2xl">
      <button
        id="hero-logo-trigger"
        class="focus-ring group mb-7 block rounded-lg"
        type="button"
        aria-label="放大查看育才物理创新实验室标志"
      >
        <img
          src="/logo-web.png"
          alt=""
          class="h-20 w-20 rounded-lg bg-white/92 object-contain p-2 shadow-soft transition duration-200 group-hover:scale-125 group-focus-visible:scale-125"
        />
      </button>
      <p class="mb-4 text-sm font-bold text-yucai-100">育才蓝 · 物理实验 · ESP32 · DIS</p>
      <h1 class="text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">{site.name}</h1>
      <p class="mt-6 max-w-xl text-base leading-8 text-blue-50 sm:text-lg">{site.intro}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {
          site.nav
            .filter((item) => item.href !== '/')
            .map((item, index) => (
              <a
                href={item.href}
                class:list={[
                  'focus-ring inline-flex h-12 items-center justify-center rounded-md px-6 text-sm font-bold transition duration-200 hover:scale-105 hover:bg-white hover:text-yucai-800 hover:shadow-soft',
                  index === 0 ? 'bg-white text-yucai-800' : 'border border-white/70 text-white'
                ]}
              >
                进入{item.label}
              </a>
            ))
        }
      </div>
    </div>
  </div>

  <div
    id="hero-logo-viewer"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/78 p-6 backdrop-blur"
    aria-hidden="true"
  >
    <button
      id="hero-logo-close"
      class="focus-ring absolute right-5 top-5 rounded-md bg-white/95 px-4 py-2 text-sm font-bold text-ink shadow-soft transition hover:bg-yucai-50"
      type="button"
    >
      关闭
    </button>
    <img
      src="/logo-web.png"
      alt="育才物理创新实验室标志"
      class="max-h-[76svh] max-w-[82vw] rounded-lg bg-white p-5 shadow-soft"
    />
  </div>

  <script>
    const logoTrigger = document.querySelector<HTMLButtonElement>('#hero-logo-trigger');
    const logoViewer = document.querySelector<HTMLDivElement>('#hero-logo-viewer');
    const logoClose = document.querySelector<HTMLButtonElement>('#hero-logo-close');

    const openLogoViewer = () => {
      if (!logoViewer) return;
      logoViewer.classList.remove('hidden');
      logoViewer.classList.add('flex');
      logoViewer.setAttribute('aria-hidden', 'false');
      logoClose?.focus();
    };

    const closeLogoViewer = () => {
      if (!logoViewer) return;
      logoViewer.classList.add('hidden');
      logoViewer.classList.remove('flex');
      logoViewer.setAttribute('aria-hidden', 'true');
      logoTrigger?.focus();
    };

    logoTrigger?.addEventListener('click', openLogoViewer);
    logoClose?.addEventListener('click', closeLogoViewer);
    logoViewer?.addEventListener('click', (event) => {
      if (event.target === logoViewer) closeLogoViewer();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && logoViewer?.getAttribute('aria-hidden') === 'false') {
        closeLogoViewer();
      }
    });
  </script>
</section>
