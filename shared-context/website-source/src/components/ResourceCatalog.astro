---
import { teachingResources, resourceCategories } from '../data/resources';
const labels = Object.fromEntries(resourceCategories.map(category => [category.id, category.label]));
---
<section class="resource-catalog" id="resources" aria-labelledby="resource-title" data-resource-catalog>
  <div class="resource-heading">
    <div><h2 id="resource-title">全部教学资源</h2><p>按知识点或用途筛选，收藏下次还要用的资源。</p></div>
    <label class="resource-search"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15 15 5 5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><input data-resource-query type="search" placeholder="搜索：动量、纸带、ESP32…" aria-label="搜索全部教学资源" /></label>
  </div>
  <div class="resource-filters" aria-label="按用途筛选">
    <button class="focus-ring" type="button" data-resource-category="all" aria-pressed="true">全部</button>
    {resourceCategories.map(category => <button class="focus-ring" type="button" data-resource-category={category.id} aria-pressed="false">{category.label}</button>)}
    <button class="focus-ring" type="button" data-resource-category="saved" aria-pressed="false">我的收藏</button>
    <span class="resource-summary" data-resource-summary aria-live="polite">共 {teachingResources.length} 个资源</span>
  </div>
  <div class="resource-list">
    {teachingResources.map((resource, index) => (
      <article class="resource-row" data-resource-id={resource.id} data-category={resource.category} data-search={`${resource.title} ${resource.description} ${resource.topic} ${resource.requirement} ${resource.keywords || ''}`.toLowerCase()}>
        <span class="resource-number">{String(index + 1).padStart(2, '0')}</span>
        <div class="resource-title"><h3><a class="focus-ring" href={resource.href}>{resource.title}</a></h3><p>{resource.description}</p></div>
        <div class="resource-meta"><strong>{labels[resource.category]}</strong><span>{resource.topic}</span><span>{resource.requirement}</span></div>
        <button class="focus-ring resource-save" type="button" data-resource-save={resource.id} data-title={resource.title} aria-label={`收藏：${resource.title}`} aria-pressed="false" hidden>☆ 收藏</button>
        <a class="focus-ring resource-open" href={resource.href} aria-label={`打开：${resource.title}`}>打开 ↗</a>
      </article>
    ))}
  </div>
  <div class="resource-empty" data-resource-empty hidden><p data-empty-message>没有找到符合条件的资源。</p><button class="focus-ring" data-resource-reset type="button">清除筛选</button></div>
  <div class="resource-bottom"><p>收藏仅保存在当前浏览器，不需要登录。</p><button class="focus-ring" type="button" data-resource-more hidden>查看更多资源 ↓</button></div>
  <p class="resource-status" data-resource-status role="status" hidden></p>
  <noscript><p>当前显示全部资源。开启 JavaScript 后可搜索、筛选与收藏。</p></noscript>
</section>
<script>
  const catalog = document.querySelector<HTMLElement>('[data-resource-catalog]');
  if (catalog) {
    const query = catalog.querySelector<HTMLInputElement>('[data-resource-query]')!;
    const rows = Array.from(catalog.querySelectorAll<HTMLElement>('[data-resource-id]'));
    const categories = Array.from(catalog.querySelectorAll<HTMLButtonElement>('[data-resource-category]'));
    const more = catalog.querySelector<HTMLButtonElement>('[data-resource-more]')!;
    const summary = catalog.querySelector('[data-resource-summary]')!;
    const empty = catalog.querySelector<HTMLElement>('[data-resource-empty]')!;
    const status = catalog.querySelector<HTMLElement>('[data-resource-status]')!;
    const storageKey = 'yucai:resource-favorites:v1';
    const validIds = new Set(rows.map(row => row.dataset.resourceId!));
    let selected = 'all';
    let limit = 8;
    let favorites = new Set<string>();
    const announce = (message: string) => { status.hidden = false; status.textContent = message; };
    const readFavorites = () => {
      try {
        const saved: unknown = JSON.parse(localStorage.getItem(storageKey) || '[]');
        if (Array.isArray(saved)) favorites = new Set(saved.filter((id): id is string => typeof id === 'string' && validIds.has(id)));
      } catch { announce('浏览器无法读取收藏，本次收藏可能无法保留。'); }
    };
    readFavorites();
    const update = () => {
      const keywords = query.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const matches = rows.filter(row => (selected === 'all' || row.dataset.category === selected || (selected === 'saved' && favorites.has(row.dataset.resourceId!))) && keywords.every(word => row.dataset.search?.includes(word)));
      const shown = new Set(matches.slice(0, limit));
      rows.forEach(row => {
        row.hidden = !shown.has(row);
        const button = row.querySelector<HTMLButtonElement>('[data-resource-save]')!;
        const saved = favorites.has(row.dataset.resourceId!);
        button.hidden = false;
        button.setAttribute('aria-pressed', String(saved));
        button.setAttribute('aria-label', `${saved ? '取消收藏' : '收藏'}：${button.dataset.title}`);
        button.textContent = saved ? '★ 已收藏' : '☆ 收藏';
      });
      summary.textContent = `找到 ${matches.length} 个 · 当前显示 ${shown.size} 个`;
      empty.hidden = matches.length !== 0;
      empty.querySelector('[data-empty-message]')!.textContent = selected === 'saved' && favorites.size === 0 ? '还没有收藏。点击资源旁的“收藏”，下次就能快速找到。' : '没有找到符合条件的资源。';
      more.hidden = matches.length <= limit;
      more.textContent = `再显示 ${Math.min(12, Math.max(0, matches.length - limit))} 个资源 ↓`;
    };
    query.addEventListener('input', () => { limit = 8; update(); });
    categories.forEach(button => button.addEventListener('click', () => {
      selected = button.dataset.resourceCategory || 'all'; limit = 8;
      categories.forEach(item => item.setAttribute('aria-pressed', String(item === button))); update();
    }));
    catalog.querySelector('[data-resource-reset]')?.addEventListener('click', () => { query.value = ''; categories[0].click(); query.focus(); });
    more.addEventListener('click', () => {
      const previous = new Set(rows.filter(row => !row.hidden));
      limit += 12; update();
      rows.find(row => !row.hidden && !previous.has(row))?.querySelector<HTMLAnchorElement>('h3 a')?.focus({ preventScroll: true });
    });
    catalog.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-resource-save]');
      const id = button?.dataset.resourceSave;
      if (!id) return;
      favorites.has(id) ? favorites.delete(id) : favorites.add(id);
      try { localStorage.setItem(storageKey, JSON.stringify([...favorites])); announce(favorites.has(id) ? '已加入本机收藏。' : '已取消收藏。'); }
      catch { announce('浏览器无法保存收藏，当前选择只在本页有效。'); }
      update();
      if (button?.closest<HTMLElement>('[data-resource-id]')?.hidden) categories.find(item => item.dataset.resourceCategory === selected)?.focus({ preventScroll: true });
    });
    window.addEventListener('storage', event => { if (event.key === storageKey || event.key === null) { favorites.clear(); readFavorites(); update(); } });
    update();
  }
</script>
