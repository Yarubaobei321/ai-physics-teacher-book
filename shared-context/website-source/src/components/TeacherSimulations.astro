---
import { momentumSimulations, simulationGroups } from '../data/simulations';
---

<section class="bg-lab">
  <div class="page-shell py-12 sm:py-16">
    <a href="/simulations/" class="focus-ring text-sm font-bold text-yucai-700 hover:text-yucai-800">← 返回模拟实验室</a>
    <div class="mt-4 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div>
        <p class="eyebrow">TEACHER WORKS</p>
        <h1 class="mt-3 text-3xl font-black text-ink sm:text-5xl">教师作品 · 动量章节模拟</h1>
      </div>
      <p class="leading-8 text-slate-700">
        由老师开发的动量章节课堂演示模型。每个页面都可以调节参数、观察动画和图像，并把水平方向动量守恒、机械能转化、共速与离轨等关键关系放在同一个模型中理解。
      </p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {
        simulationGroups.map((group) => (
          <article class="rounded-md border border-slate-200 bg-white p-5">
            <p class="text-sm font-black text-yucai-700">{group.name}</p>
            <p class="mt-3 leading-7 text-slate-700">{group.description}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 space-y-10">
      {
        simulationGroups.map((group) => {
          const items = momentumSimulations.filter((item) => item.group === group.id);

          return (
            <section aria-labelledby={`group-${group.id}`}>
              <div class="flex flex-col gap-2 border-b border-slate-200 pb-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="eyebrow">MOMENTUM MODELS</p>
                  <h2 id={`group-${group.id}`} class="mt-2 text-2xl font-black text-ink">
                    {group.name}
                  </h2>
                </div>
                <p class="text-sm font-semibold text-slate-500">{items.length} 个模型</p>
              </div>

              <div class="mt-5 grid gap-5 lg:grid-cols-2">
                {
                  items.map((item) => (
                    <article class="tool-surface flex h-full flex-col overflow-hidden">
                      <div class="flex flex-1 flex-col p-6">
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="rounded-md bg-yucai-50 px-3 py-1 text-sm font-black text-yucai-800">
                            {item.modelLabel}
                          </span>
                          <span class="rounded-md bg-slate-100 px-3 py-1 text-sm font-bold text-slate-600">
                            动量章节
                          </span>
                        </div>

                        <h3 class="mt-5 text-2xl font-black text-ink">{item.title}</h3>
                        <p class="mt-3 leading-8 text-slate-700">{item.summary}</p>

                        <div class="mt-5 grid gap-3">
                          <div class="rounded-md bg-yucai-50 p-4">
                            <p class="text-xs font-black uppercase tracking-normal text-yucai-700">
                              守恒关系
                            </p>
                            <p class="mt-2 leading-7 text-slate-800">{item.conservation}</p>
                          </div>
                          <div class="rounded-md bg-white p-4 ring-1 ring-slate-200">
                            <p class="text-xs font-black uppercase tracking-normal text-slate-500">
                              课堂观察
                            </p>
                            <p class="mt-2 leading-7 text-slate-700">{item.teachingPoint}</p>
                          </div>
                        </div>
                      </div>

                      <div class="border-t border-slate-200 bg-slate-50 p-4">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                          <a
                            href={item.href}
                            class="focus-ring inline-flex min-h-10 items-center justify-center rounded-md bg-yucai-700 px-4 py-2 text-sm font-black text-white transition hover:bg-yucai-800"
                          >
                            进入实验
                          </a>
                          <div class="flex flex-wrap gap-2">
                            {
                              item.gifs.map((gif) => (
                                <a
                                  href={gif.href}
                                  download
                                  class="focus-ring inline-flex min-h-10 items-center justify-center rounded-md border border-yucai-200 bg-white px-3 py-2 text-sm font-black text-yucai-800 transition hover:border-yucai-400 hover:bg-yucai-50"
                                >
                                  下载：{gif.label}
                                </a>
                              ))
                            }
                          </div>
                        </div>
                      </div>
                    </article>
                  ))
                }
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</section>
