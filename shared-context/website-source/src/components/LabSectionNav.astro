---
interface Props { slug: string }
const { slug } = Astro.props;
---
<nav class="lab-section-nav" aria-label="实验页快捷导航">
  <a class="focus-ring" href="#lab-workbench">填写数据 ↓</a>
  <a class="focus-ring" href="#lab-analysis">查看图像</a>
  <a class="focus-ring" href={`#lab-review-${slug}`}>实验回顾</a>
  <a class="focus-ring" href={`#exercises-${slug}`}>配套习题</a>
</nav>
<style>
  .lab-section-nav{display:flex;flex-wrap:wrap;gap:8px;margin-block:18px}
  a{display:flex;align-items:center;min-height:44px;padding:8px 12px;border:1px solid #b7dcff;border-radius:6px;font-size:13px;font-weight:600;color:#074f9f;text-decoration:none;background:white}
  a:first-child{background:#0b63c7;border-color:#0b63c7;color:white}a:hover{background:#d8ecff;color:#074f9f}
</style>
