---
import BaseLayout from '../../../components/BaseLayout.astro';
import labSource from '../../../data/student-ai-lab.json';
import {
  evidenceRules,
  evidenceSequence,
  fieldTask,
  literacyPage,
  originalRubric,
  originalScoringProcedure,
  readStudentAiCatalog,
  researchBoundary,
  researchTracks,
  scoreBands
} from '../../../data/student-ai-literacy';

const lab = readStudentAiCatalog(labSource);
const scoredItems = lab.items.filter((item) => item.score !== null);
const scoreMean = scoredItems.length
  ? scoredItems.reduce((sum, item) => sum + (item.score?.total ?? 0), 0) / scoredItems.length
  : null;
const distribution = scoreBands.map((band) => {
  const count = scoredItems.filter((item) => {
    const score = item.score?.total;
    return score !== undefined && score >= band.min && score <= band.max;
  }).length;

  return {
    ...band,
    count,
    percentage: scoredItems.length ? Math.round((count / scoredItems.length) * 100) : 0
  };
});
---

<BaseLayout
  title={`${literacyPage.title} | 育才物理创新实验室`}
  description="77 份八学科代号化学生作品：介绍现场任务、原始五维规则与作者开发的 v4 双轨 AI 研究性评分，并展示对话、版本对比和优化对照。"
>
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="absolute inset-0 bg-[linear-gradient(112deg,rgba(16,32,51,0.98)_0%,rgba(13,57,105,0.96)_52%,rgba(11,99,199,0.82)_100%)]"></div>
    <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full border border-yucai-300/20"></div>
    <div class="absolute -bottom-48 right-28 h-96 w-96 rounded-full border border-yucai-100/15"></div>
    <div class="page-shell relative grid gap-10 py-16 lg:grid-cols-[1.25fr_0.75fr] lg:items-center lg:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-bold tracking-wide text-yucai-100">{literacyPage.eyebrow}</p>
        <h1 class="mt-4 text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">
          {literacyPage.title}
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-blue-50 sm:text-lg">
          {literacyPage.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#works"
            class="focus-ring inline-flex h-12 items-center rounded-md bg-white px-6 text-sm font-black text-yucai-800 transition duration-200 hover:scale-105 hover:shadow-soft"
          >
            浏览 77 份作品
          </a>
          <a
            href="#rules"
            class="focus-ring inline-flex h-12 items-center rounded-md border border-white/70 px-6 text-sm font-black text-white transition duration-200 hover:bg-white/10"
          >
            先看评价规则
          </a>
        </div>
      </div>

      <aside class="rounded-lg border border-white/20 bg-white/10 p-6 backdrop-blur-sm" aria-label="研究库概要">
        <p class="text-sm font-bold text-yucai-100">EVIDENCE-BASED REVIEW</p>
        <p class="mt-3 text-2xl font-black">{literacyPage.scope}</p>
        <p class="mt-4 leading-7 text-blue-50">{literacyPage.disclaimer}</p>
        <dl class="mt-6 grid grid-cols-2 gap-3">
          <div class="rounded-md border border-white/15 bg-ink/20 p-4">
            <dt class="text-xs font-bold text-yucai-100">作品</dt>
            <dd class="mt-1 text-3xl font-black tabular-nums">{lab.count}</dd>
          </div>
          <div class="rounded-md border border-white/15 bg-ink/20 p-4">
            <dt class="text-xs font-bold text-yucai-100">学科</dt>
            <dd class="mt-1 text-3xl font-black tabular-nums">{lab.subjects.length}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section-band bg-white" id="rules">
    <div class="page-shell">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <p class="eyebrow">FIELD TASK · 现场任务</p>
          <h2 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-4xl">
            50 分钟里，AI 如何成为学习伙伴？
          </h2>
          <p class="mt-5 leading-8 text-slate-700">{fieldTask.description}</p>
          <dl class="mt-7 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
            <div class="border-l-4 border-yucai-600 bg-lab p-4">
              <dt class="text-xs font-bold text-slate-500">现场时长</dt>
              <dd class="mt-1 text-lg font-black text-ink">{fieldTask.duration}</dd>
            </div>
            <div class="border-l-4 border-yucai-600 bg-lab p-4">
              <dt class="text-xs font-bold text-slate-500">统一工具</dt>
              <dd class="mt-1 text-lg font-black text-ink">{fieldTask.tool}</dd>
            </div>
            <div class="border-l-4 border-yucai-600 bg-lab p-4">
              <dt class="text-xs font-bold text-slate-500">最终成果</dt>
              <dd class="mt-1 font-black leading-6 text-ink">{fieldTask.deliverable}</dd>
            </div>
          </dl>
        </div>

        <div class="tool-surface p-6 sm:p-8">
          <p class="text-sm font-black text-yucai-700">现场完成路径</p>
          <ol class="mt-5 grid gap-4 sm:grid-cols-2">
            {
              fieldTask.steps.map((step, index) => (
                <li class="flex gap-4 rounded-md border border-slate-200 bg-white p-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-yucai-100 text-sm font-black text-yucai-800 tabular-nums">
                    {index + 1}
                  </span>
                  <span class="pt-1 text-sm font-bold leading-6 text-slate-700">{step}</span>
                </li>
              ))
            }
          </ol>
          <div class="mt-7 border-t border-slate-200 pt-6">
            <p class="text-sm font-black text-ink">每份案例按同一证据链阅读</p>
            <ol class="mt-4 space-y-3">
              {
                evidenceSequence.map((step, index) => (
                  <li class="flex items-start gap-3 text-sm leading-6 text-slate-700">
                    <span class="mt-0.5 font-black text-yucai-700 tabular-nums">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span>{step}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-band bg-lab" id="original-rubric">
    <div class="page-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">ORIGINAL RUBRIC · 现场原始规则</p>
        <h2 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-4xl">五个维度，共 100 分</h2>
        <p class="mt-5 leading-8 text-slate-700">
          这是现场说明中的原始评价标准，用于交代任务背景；下方研究库展示的 v4 分数来自另一套研究性量规，两者不能混为一谈。
        </p>
      </div>

      <div class="mt-9 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        {
          originalRubric.map((criterion) => (
            <article class="flex h-full flex-col border-t-4 border-yucai-600 bg-white p-5 shadow-sm">
              <p class="text-3xl font-black text-yucai-700 tabular-nums">
                {criterion.points}<span class="ml-1 text-sm">分</span>
              </p>
              <h3 class="mt-3 text-lg font-black leading-snug text-ink">{criterion.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-slate-700">{criterion.description}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-7 rounded-lg border border-yucai-200 bg-yucai-50 p-5 sm:flex sm:items-start sm:gap-5">
        <span class="inline-flex rounded-full bg-yucai-700 px-3 py-1 text-xs font-black text-white">计分规则</span>
        <p class="mt-3 leading-7 text-slate-700 sm:mt-0">{originalScoringProcedure}</p>
      </div>
    </div>
  </section>

  <section class="section-band bg-white" id="research-rubric">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">V4 RESEARCH RUBRIC · 作者开发</p>
          <h2 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-4xl">
            双轨评分：A 轨 60 + B 轨 40
          </h2>
        </div>
        <p class="leading-8 text-slate-700">
          v4 把“学生怎样与 AI 协作”和“最后作品质量如何”拆开评价。这样可以避免仅凭成品漂亮就高估协作能力，也避免用对话轮数替代作品核验。
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          researchTracks.map((track) => (
            <article class="overflow-hidden rounded-lg border border-yucai-200 bg-white shadow-soft">
              <header class="flex items-start justify-between gap-5 bg-yucai-900 p-6 text-white">
                <div>
                  <p class="text-sm font-bold text-yucai-100">{track.id} TRACK</p>
                  <h3 class="mt-2 text-2xl font-black">{track.name}</h3>
                </div>
                <p class="text-right text-4xl font-black tabular-nums">
                  {track.points}<span class="ml-1 text-sm text-yucai-100">分</span>
                </p>
              </header>
              <p class="border-b border-slate-200 bg-yucai-50 px-6 py-4 text-sm leading-7 text-slate-700">
                {track.summary}
              </p>
              <ol class="divide-y divide-slate-200 px-6">
                {
                  track.dimensions.map((dimension) => (
                    <li class="grid gap-2 py-5 sm:grid-cols-[auto_1fr_auto] sm:gap-x-4">
                      <span class="row-span-2 flex h-9 w-9 items-center justify-center rounded-md bg-yucai-100 text-xs font-black text-yucai-800">
                        {dimension.id}
                      </span>
                      <h4 class="font-black text-ink">{dimension.name}</h4>
                      <span class="text-sm font-black text-yucai-700 tabular-nums sm:text-right">
                        {dimension.points} 分
                      </span>
                      <p class="text-sm leading-6 text-slate-600 sm:col-start-2 sm:col-end-4">
                        {dimension.description}
                      </p>
                    </li>
                  ))
                }
              </ol>
            </article>
          ))
        }
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <article class="rounded-lg border border-slate-200 bg-lab p-6 sm:p-7">
          <p class="text-sm font-black text-yucai-700">EVIDENCE DISCIPLINE</p>
          <h3 class="mt-2 text-2xl font-black text-ink">证据纪律</h3>
          <ul class="mt-5 space-y-4">
            {
              evidenceRules.map((rule) => (
                <li class="flex gap-3 leading-7 text-slate-700">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-yucai-600"></span>
                  <span>{rule}</span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="rounded-lg border border-slate-200 bg-lab p-6 sm:p-7">
          <p class="text-sm font-black text-yucai-700">RESEARCH BOUNDARY</p>
          <h3 class="mt-2 text-2xl font-black text-ink">匿名与研究边界</h3>
          <ul class="mt-5 space-y-4">
            {
              researchBoundary.map((rule) => (
                <li class="flex gap-3 leading-7 text-slate-700">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-signal"></span>
                  <span>{rule}</span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section-band bg-lab" id="statistics">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <p class="eyebrow">ANONYMOUS OVERVIEW · 匿名统计</p>
          <h2 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-4xl">只看整体，不做排名</h2>
          <p class="mt-5 leading-8 text-slate-700">
            统计只用于理解样本结构和分数分布。目录沿用代号顺序，不按得分重新排列；分数区间也不代表学生等级。
          </p>
          <dl class="mt-7 grid grid-cols-3 gap-3">
            <div class="rounded-md border border-slate-200 bg-white p-4">
              <dt class="text-xs font-bold text-slate-500">作品总数</dt>
              <dd class="mt-2 text-2xl font-black text-ink tabular-nums">{lab.count}</dd>
            </div>
            <div class="rounded-md border border-slate-200 bg-white p-4">
              <dt class="text-xs font-bold text-slate-500">已有 v4 分</dt>
              <dd class="mt-2 text-2xl font-black text-ink tabular-nums">{scoredItems.length}</dd>
            </div>
            <div class="rounded-md border border-slate-200 bg-white p-4">
              <dt class="text-xs font-bold text-slate-500">匿名均值</dt>
              <dd class="mt-2 text-2xl font-black text-ink tabular-nums">
                {scoreMean === null ? '—' : scoreMean.toFixed(1)}
              </dd>
            </div>
          </dl>
          <p class="mt-3 text-xs leading-5 text-slate-500">
            均值与区间按当前已同步的 v4 研究性评分计算，数据补齐后自动更新。
          </p>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-soft sm:p-7">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="text-sm font-black text-yucai-700">SCORE DISTRIBUTION</p>
              <h3 class="mt-2 text-xl font-black text-ink">v4 总分区间</h3>
            </div>
            <p class="text-sm font-bold text-slate-500">样本 n = {scoredItems.length}</p>
          </div>
          <div class="mt-6 space-y-4">
            {
              distribution.map((band) => (
                <div class="grid grid-cols-[4.5rem_1fr_3rem] items-center gap-3">
                  <span class="text-sm font-bold text-slate-600 tabular-nums">{band.label}</span>
                  <div class="h-2 overflow-hidden rounded-full bg-slate-100" aria-hidden="true">
                    <div
                      class="h-full rounded-full bg-yucai-600"
                      style={`width: ${band.percentage}%`}
                    ></div>
                  </div>
                  <span class="text-right text-sm font-black text-ink tabular-nums">{band.count}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          lab.subjects.map((subject) => (
            <div class="flex items-center justify-between rounded-md border border-slate-200 bg-white px-5 py-4">
              <span class="font-black text-ink">{subject.label}</span>
              <span class="text-sm font-bold text-slate-500 tabular-nums">{subject.count} 份</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-band bg-white" id="works">
    <div class="page-shell">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">WORK CATALOG · 作品目录</p>
          <h2 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-4xl">按学科浏览 77 份作品</h2>
          <p class="mt-4 leading-7 text-slate-700">
            所有卡片只显示学科代号。选择学科仅改变可见范围，作品始终保持代号顺序，不按 v4 分数排序。
          </p>
        </div>
        <p id="catalog-count" class="text-sm font-bold text-slate-500" aria-live="polite">
          当前显示 {lab.items.length} 份
        </p>
      </div>

      <div class="mt-7 flex flex-wrap gap-2" id="subject-filters" role="group" aria-label="按学科筛选作品">
        <button
          type="button"
          data-subject="all"
          aria-pressed="true"
          class="subject-filter focus-ring is-active rounded-md border border-yucai-700 bg-yucai-700 px-3 py-2 text-sm font-bold text-white"
        >
          全部 · {lab.items.length}
        </button>
        {
          lab.subjects.map((subject) => (
            <button
              type="button"
              data-subject={subject.id}
              aria-pressed="false"
              class="subject-filter focus-ring rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-slate-700 transition hover:border-yucai-500 hover:bg-yucai-50 hover:text-yucai-800"
            >
              {subject.label} · {subject.count}
            </button>
          ))
        }
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" id="lab-grid">
        {
          lab.items.map((item) => (
            <a
              href={`/simulations/student-ai-lab/${item.alias}/`}
              data-subject={item.subject}
              class="lab-card focus-ring group flex min-w-0 flex-col rounded-lg border border-slate-200 bg-lab p-5 transition duration-200 hover:-translate-y-0.5 hover:border-yucai-500 hover:bg-yucai-50"
            >
              <div class="flex items-start justify-between gap-3">
                <div>
                  <span class="text-sm font-black text-yucai-700">{item.alias}</span>
                  <span class="ml-2 text-xs font-bold text-slate-500">{item.subjectLabel}</span>
                </div>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2.5 py-1 text-xs font-black tabular-nums',
                    item.score
                      ? 'bg-yucai-100 text-yucai-800'
                      : 'border border-slate-200 bg-white text-slate-500'
                  ]}
                >
                  {item.score ? `AI v4 ${item.score.total}/100` : 'v4 待同步'}
                </span>
              </div>
              <h3 class="mt-3 line-clamp-2 text-lg font-black leading-snug text-ink group-hover:text-yucai-800">
                {item.topic}
              </h3>

              {
                item.score && item.score.trackA !== null && item.score.trackB !== null && (
                  <p class="mt-3 text-xs font-bold text-slate-500 tabular-nums">
                    A 轨 {item.score.trackA}/60 · B 轨 {item.score.trackB}/40
                  </p>
                )
              }

              <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold text-slate-600">
                {item.evidence.hasConversation && (
                  <span class="rounded bg-white px-2 py-1">完整对话</span>
                )}
                {item.evidence.hasVersionComparison && (
                  <span class="rounded bg-white px-2 py-1">首版 / 终稿</span>
                )}
                {item.evidence.hasOptimalPrompt && (
                  <span class="rounded bg-white px-2 py-1">最优提示词</span>
                )}
                {item.evidence.hasDeepseekOptimized && (
                  <span class="rounded bg-white px-2 py-1">优化对照</span>
                )}
                {item.evidence.singleStage && (
                  <span class="rounded border border-slate-200 bg-white px-2 py-1">单阶段</span>
                )}
                {item.evidence.firstVersionMatchesSubmission && (
                  <span class="rounded border border-slate-200 bg-white px-2 py-1">首版与提交版一致</span>
                )}
                {item.evidence.conversationLastVersionDiffers && (
                  <span class="rounded border border-signal/40 bg-amber-50 px-2 py-1 text-amber-800">
                    提交版与对话末版不同
                  </span>
                )}
              </div>
              <span class="mt-5 text-sm font-black text-yucai-700">查看完整证据链 →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lab-card[hidden] {
    display: none;
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.subject-filter'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.lab-card'));
  const countLabel = document.querySelector<HTMLElement>('#catalog-count');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const subject = button.dataset.subject ?? 'all';
      let visibleCount = 0;

      buttons.forEach((candidate) => {
        const isActive = candidate === button;
        candidate.setAttribute('aria-pressed', String(isActive));
        candidate.classList.toggle('is-active', isActive);
        candidate.classList.toggle('bg-yucai-700', isActive);
        candidate.classList.toggle('text-white', isActive);
        candidate.classList.toggle('border-yucai-700', isActive);
        candidate.classList.toggle('bg-white', !isActive);
        candidate.classList.toggle('text-slate-700', !isActive);
        candidate.classList.toggle('border-slate-200', !isActive);
      });

      cards.forEach((card) => {
        const matches = subject === 'all' || card.dataset.subject === subject;
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      if (countLabel) countLabel.textContent = `当前显示 ${visibleCount} 份`;
    });
  });
</script>
