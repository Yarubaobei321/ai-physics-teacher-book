---
import BaseLayout from '../../../components/BaseLayout.astro';
import { gaokaoSimulationItems } from '../../../data/gaokao-simulations';

const topics = [...new Set(gaokaoSimulationItems.map((item) => item.topic))];
const years = [...new Set(gaokaoSimulationItems.map((item) => item.year))].sort((a, b) => b - a);
---

<BaseLayout
  title="高考真题模拟 | 育才物理创新实验室"
  description="探索 20 道广东高考物理题：改变参数，观察运动与图像，比较物理量之间的关系。"
>
  <section class="section-band bg-lab">
    <div class="page-shell">
      <a href="/simulations/" class="focus-ring text-sm font-bold text-yucai-700 hover:text-yucai-800">
        ← 返回模拟实验室
      </a>

      <div class="mt-5 grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <p class="eyebrow">GAOKAO SIMULATIONS</p>
          <h1 class="mt-3 max-w-4xl text-3xl font-black tracking-tight text-ink sm:text-5xl">
            让题目中的物理过程看得见
          </h1>
        </div>
        <div class="border-l-4 border-yucai-600 bg-white p-6 shadow-soft">
          <p class="text-sm font-black text-yucai-700">先预测，再用模型观察</p>
          <p class="mt-3 leading-8 text-slate-700">
            先判断改变一个条件会发生什么，再调整参数，结合动画与图像解释你的观察。
          </p>
        </div>
      </div>

      <section class="mt-12" aria-labelledby="catalog-title" data-gaokao-catalog>
        <div class="grid gap-7 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
          <div>
            <p class="eyebrow">MODEL LIBRARY</p>
            <h2 id="catalog-title" class="mt-2 text-2xl font-black text-ink">20 道高考题，逐题探究</h2>
            <p class="mt-4 leading-8 text-slate-700">
              按年份、专题或关键词找题。进入模型后，先阅读条件与假设，再观察过程、比较图像。
            </p>
          </div>

          <div class="grid gap-4 rounded-md border border-slate-200 bg-white p-5 sm:grid-cols-3">
            <label class="grid gap-2 text-sm font-black text-ink">
              年份
              <select data-filter-year class="focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 font-semibold text-slate-700">
                <option value="">全部年份</option>
                {years.map((year) => <option value={year}>{year}</option>)}
              </select>
            </label>
            <label class="grid gap-2 text-sm font-black text-ink">
              专题
              <select data-filter-topic class="focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 font-semibold text-slate-700">
                <option value="">全部专题</option>
                {topics.map((topic) => <option value={topic}>{topic}</option>)}
              </select>
            </label>
            <label class="grid gap-2 text-sm font-black text-ink">
              知识点或关键词
              <input
                data-filter-query
                type="search"
                placeholder="如：碰撞、波形"
                class="focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 font-semibold text-slate-700"
              />
            </label>
          </div>
        </div>

        <p class="mt-5 text-sm font-bold text-slate-500" data-filter-summary aria-live="polite">
          显示 {gaokaoSimulationItems.length} 道题
        </p>

        <div class="mt-3 divide-y divide-slate-200 border-y border-slate-200 bg-white" data-model-list>
          {
            gaokaoSimulationItems.map((item) => (
              <article
                data-catalog-item
                data-year={item.year}
                data-topic={item.topic}
                data-search={`${item.title} ${item.interaction} ${item.chapters}`}
                class="grid gap-3 px-5 py-6 sm:grid-cols-[88px_120px_minmax(0,1fr)] sm:items-center lg:grid-cols-[88px_120px_minmax(0,1fr)_150px_auto] lg:px-7"
              >
                <p class="mb-0 text-xl font-black text-ink">{item.year}</p>
                <div>
                  <p class="mb-0 text-xs font-black text-yucai-700">{item.topic}</p>
                </div>
                <div>
                  <h3 class="mb-0 text-base font-black text-ink">{item.title}</h3>
                  <p class="mb-0 mt-2 text-sm leading-6 text-slate-600">{item.interaction}</p>
                </div>
                <p class="mb-0 text-xs leading-6 text-slate-500 sm:text-right">《智启格物》<br />{item.chapters}</p>
                <a
                  href={item.href}
                  class="focus-ring inline-flex min-h-11 items-center justify-center rounded-md bg-yucai-700 px-5 text-sm font-black text-white transition active:scale-[0.98] hover:bg-yucai-800 sm:col-start-3 sm:justify-self-start lg:col-start-auto lg:justify-self-auto"
                >
                  进入模型
                </a>
              </article>
            ))
          }
        </div>

        <div data-filter-empty hidden class="mt-4 border border-dashed border-slate-300 bg-white p-8 text-center text-slate-600">
          当前筛选条件下没有模型。请清空关键词或切换年份、专题。
        </div>
      </section>

      <section class="mt-14 border-l-4 border-signal bg-amber-50 p-6" aria-labelledby="rules-title">
        <h2 id="rules-title" class="text-xl font-black text-ink">观察之后，回到物理解释</h2>
        <p class="mb-0 mt-3 max-w-5xl leading-8 text-slate-700">
          用受力、守恒关系或图像解释你观察到的变化，再与原题条件对照。
          注意每个模型标明的理想化假设与适用范围；动画和计算结果不能代替真实实验测量。
        </p>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  const catalog = document.querySelector('[data-gaokao-catalog]');
  if (catalog) {
    const year = catalog.querySelector('[data-filter-year]');
    const topic = catalog.querySelector('[data-filter-topic]');
    const query = catalog.querySelector('[data-filter-query]');
    const rows = Array.from(catalog.querySelectorAll('[data-catalog-item]'));
    const summary = catalog.querySelector('[data-filter-summary]');
    const empty = catalog.querySelector('[data-filter-empty]');

    const update = () => {
      const yearValue = year instanceof HTMLSelectElement ? year.value : '';
      const topicValue = topic instanceof HTMLSelectElement ? topic.value : '';
      const queryValue = query instanceof HTMLInputElement ? query.value.trim().toLowerCase() : '';
      let visible = 0;

      rows.forEach((row) => {
        const matchesYear = !yearValue || row.getAttribute('data-year') === yearValue;
        const matchesTopic = !topicValue || row.getAttribute('data-topic') === topicValue;
        const search = (row.getAttribute('data-search') || '').toLowerCase();
        const matchesQuery = !queryValue || search.includes(queryValue);
        const show = matchesYear && matchesTopic && matchesQuery;
        row.toggleAttribute('hidden', !show);
        if (show) visible += 1;
      });

      if (summary) summary.textContent = `显示 ${visible} 道题`;
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    };

    year?.addEventListener('change', update);
    topic?.addEventListener('change', update);
    query?.addEventListener('input', update);
  }
</script>
