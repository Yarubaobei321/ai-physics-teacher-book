---
import BaseLayout from '../../components/BaseLayout.astro';
import { simulationCount } from '../../data/simulations';

const teacherEntries = [
  {
    tag: '图书配套',
    title: '高考真题模拟',
    text: '改变题目参数，观察运动过程与图像，理解广东高考物理题中的关键关系。',
    meta: '20 道高考题 · 可调参数与图像',
    href: '/simulations/gaokao/',
    status: '进入高考真题模拟'
  },
  {
    tag: '教师自研',
    title: '动量章节模拟',
    text: '动量章节课堂演示模型：可调参数、观察动画与图像，把守恒、机械能转化、共速与离轨放在同一模型中理解。',
    meta: `${simulationCount} 个演示模型 · 10 GIF 素材`,
    href: '/simulations/teacher/',
    status: '进入教师作品'
  }
];

const studentEntries = [
  {
    tag: '教学与论文研究',
    title: '学生 AI 素养评价',
    text: '以 77 份代号化作品呈现真实对话、DeepSeek 第一版、学生提交最终版、AI 研究性评分、最优提示词与优化对照。',
    meta: '77 份作品 · 八学科 · 只显示代号 · 不设排名',
    href: '/simulations/student-ai-lab/',
    status: '查看评价与作品'
  }
];
---

<BaseLayout
  title="模拟实验室 | 育才物理创新实验室"
  description="模拟实验室分为教师作品区与学生作品区：课堂演示模型、高考真题模拟，以及用于教学和论文研究的学生 AI 素养评价。"
>
  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">SIMULATION LAB</p>
          <h1 class="mt-3 text-3xl font-black text-ink sm:text-5xl">模拟实验室</h1>
        </div>
        <p class="leading-8 text-slate-700">
          在<strong class="font-black text-ink">教师作品区</strong>选择模型，用于课堂演示或自主探究；
          在<strong class="font-black text-ink">学生作品区</strong>查看 AI 协作的对话与作品，比较提问、修改和验证的方法。
        </p>
      </div>

      <div class="mt-14">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow">TEACHER ZONE</p>
            <h2 class="mt-2 text-2xl font-black text-ink sm:text-3xl">教师作品区</h2>
          </div>
          <p class="text-sm font-bold text-slate-500">高考真题 · 动量章节演示</p>
        </div>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {
            teacherEntries.map((entry) => (
              <a
                href={entry.href}
                class="focus-ring group flex h-full flex-col rounded-lg border border-slate-200 bg-white p-7 shadow-soft transition hover:-translate-y-1 hover:border-yucai-200"
              >
                <p class="text-sm font-black text-yucai-700">{entry.tag}</p>
                <h3 class="mt-3 text-2xl font-black leading-tight text-ink">{entry.title}</h3>
                <p class="mb-5 mt-4 flex-1 leading-8 text-slate-700">{entry.text}</p>
                <p class="text-sm font-bold text-slate-500">{entry.meta}</p>
                <span class="mt-5 inline-flex h-11 items-center justify-center self-start rounded-md bg-yucai-700 px-5 text-sm font-black text-white transition group-hover:bg-yucai-800">
                  {entry.status}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-14">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow">STUDENT ZONE</p>
            <h2 class="mt-2 text-2xl font-black text-ink sm:text-3xl">学生作品区</h2>
          </div>
          <p class="text-sm font-bold text-slate-500">AI 素养评价 · 教学研究 · 代号展示</p>
        </div>
        <div class="mt-6 grid gap-6">
          {
            studentEntries.map((entry) => (
              <a
                href={entry.href}
                class="focus-ring group flex h-full flex-col rounded-lg border border-yucai-200 bg-white p-7 shadow-soft transition hover:-translate-y-1 hover:border-yucai-500 hover:bg-yucai-50 md:flex-row md:items-center md:gap-10"
              >
                <div class="flex-1">
                  <p class="text-sm font-black text-yucai-700">{entry.tag}</p>
                  <h3 class="mt-3 text-2xl font-black leading-tight text-ink">{entry.title}</h3>
                  <p class="mt-4 leading-8 text-slate-700">{entry.text}</p>
                  <p class="mt-3 text-sm font-bold text-slate-500">{entry.meta}</p>
                </div>
                <span class="mt-5 inline-flex h-11 shrink-0 items-center justify-center self-start rounded-md bg-yucai-700 px-5 text-sm font-black text-white transition group-hover:bg-yucai-800 md:mt-0">
                  {entry.status}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
