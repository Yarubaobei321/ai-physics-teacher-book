---
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <Hero />

  <section class="section-band bg-white">
    <div class="page-shell">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">LAB DIRECTION</p>
          <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl">从课堂问题出发，把实验做成作品</h2>
        </div>
        <p class="leading-8 text-slate-700">
          站点有两条主线：真实实验与模拟演示。<strong class="text-ink">在线实验室</strong>整合在线编程、网页版 DIS 与验证机械能守恒案例实验，让 ESP32 程序模板、传感器数据采集和可填写、可计算的网页报告都在浏览器里完成；<strong class="text-ink">模拟实验室</strong>把抽象物理过程变成可调参数、可看图像的课堂演示。
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          site.directions.map((item) => (
            <article class="border-t-4 border-yucai-600 bg-lab p-6">
              <h3 class="text-xl font-black text-ink">{item.title}</h3>
              <p class="mt-4 leading-7 text-slate-700">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="overflow-hidden rounded-lg border border-yucai-200 bg-white shadow-soft">
        <div class="grid gap-0 md:grid-cols-[1.1fr_0.9fr]">
          <div class="p-7 sm:p-9">
            <p class="text-sm font-black text-signal">PROJECT-BASED LEARNING · 暑假作业</p>
            <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl">暑假项目式学习</h2>
            <p class="mt-4 leading-8 text-slate-700">
              分为新高一、新高二和 DIS传感器实验三类。学生可以在网页中填写原始数据，自动完成关键物理量计算、生成图表，并导出 CSV 与结果图片。
            </p>
            <a href="/project-learning/" class="focus-ring mt-6 inline-flex text-sm font-black text-yucai-700 transition hover:text-yucai-800">进入项目页面 →</a>
          </div>
          <div class="flex flex-col justify-center gap-3 border-t border-slate-200 bg-yucai-50 p-7 sm:p-9 md:border-l md:border-t-0">
            <a href="/project-learning/new-grade-one/" class="focus-ring block rounded-md bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:bg-[#eef7ff] hover:shadow-md">
              <p class="text-xs font-black text-yucai-700">新高一</p>
              <p class="mt-1 font-black text-ink">测定重力加速度 g</p>
            </a>
            <a href="/project-learning/new-grade-two/" class="focus-ring block rounded-md bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:bg-[#fff7ed] hover:shadow-md">
              <p class="text-xs font-black text-[#b9760a]">新高二</p>
              <p class="mt-1 font-black text-ink">力学综合探究实验</p>
            </a>
            <a href="/project-learning/dis-sensor/" class="focus-ring block rounded-md bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ecfdf5] hover:shadow-md">
              <p class="text-xs font-black text-emerald-700">DIS传感器实验</p>
              <p class="mt-1 font-black text-ink">ESP32 超声波追踪小车</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-band bg-white">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="eyebrow">MAKER PARK</p>
          <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl">科创天地</h2>
          <p class="mt-4 leading-8 text-slate-700">
            智能硬件物理创新实验作品的展示舞台。整合电路设计、结构设计、3D 打印和 ESP32 智能控制，把物理想法做成真实装置。
          </p>
        </div>
        <a href="/maker/" class="focus-ring block rounded-md border border-yucai-200 bg-yucai-50 p-6 transition hover:border-yucai-500 hover:bg-[#eef7ff]">
          <p class="text-sm font-black text-yucai-800">SMART HARDWARE · 作品展示</p>
          <h3 class="mt-3 text-2xl font-black text-ink">进入科创天地</h3>
          <p class="mt-4 leading-7 text-slate-700">
            查看智能硬件创新实验、精选图片和视频，以及智能小车教学控制台、尘光一号火星车网页地面站等作品。
          </p>
          <span class="mt-5 inline-flex text-sm font-black text-yucai-800">进入科创天地</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <p class="eyebrow">LAB TOOLS</p>
          <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl">在线工具与模拟实验</h2>
          <p class="mt-4 leading-8 text-slate-700">
            这里放课堂和项目中会反复使用的网页工具：一个负责真实数据采集与报告生成，一个负责把抽象物理过程可视化。
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          <a href="/online-lab/" class="focus-ring block rounded-md border border-yucai-200 bg-white p-6 shadow-soft transition hover:-translate-y-0.5 hover:border-yucai-500 hover:bg-[#eef7ff]">
            <p class="text-sm font-black text-yucai-800">ONLINE LAB · 数据采集</p>
            <h3 class="mt-3 text-2xl font-black text-ink">在线实验室</h3>
            <p class="mt-4 leading-7 text-slate-700">
              整合在线编程、网页版 DIS 与机械能守恒实验，在浏览器里完成烧录、采集、作图和可计算的网页实验报告。
            </p>
            <span class="mt-5 inline-flex text-sm font-black text-yucai-800">进入实验室</span>
          </a>

          <a href="/simulations/" class="focus-ring block rounded-md border border-yucai-200 bg-white p-6 shadow-soft transition hover:-translate-y-0.5 hover:border-yucai-500 hover:bg-[#eef7ff]">
            <p class="text-sm font-black text-yucai-800">SIMULATION LAB · 课堂演示</p>
            <h3 class="mt-3 text-2xl font-black text-ink">模拟实验室</h3>
            <p class="mt-4 leading-7 text-slate-700">
              用可调参数、动态轨迹和图像，把动量守恒、机械能转化、共速与离轨等物理过程和习题条件可视化。
            </p>
            <span class="mt-5 inline-flex text-sm font-black text-yucai-800">开始模拟</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
