---
import BaseLayout from '../../components/BaseLayout.astro';
import { collectorProgram, ultrasonicExperiment } from '../../data/project-learning';

const hardwareImages = [
  {
    name: 'ESP32 开发板',
    spec: 'ESP32-38Pin CH340 TYPE-C',
    src: '/images/project-learning/dis-sensor/ESP32开发板.webp'
  },
  {
    name: 'ESP32 扩展板',
    spec: '把开发板插到中间排母，传感器线接到两侧引脚区',
    src: '/images/project-learning/dis-sensor/ESP32拓展板.webp'
  },
  {
    name: 'HC-SR04P 超声波模块',
    spec: '宽电压版，按 VCC / Trig / Echo / GND 四根线连接',
    src: '/images/project-learning/dis-sensor/HC-SR04P 超声波模块.webp'
  },
  {
    name: '杜邦线',
    spec: '母对母 4 根，建议用不同颜色区分电源、地线和信号线',
    src: '/images/project-learning/dis-sensor/杜邦线（母对母）.webp'
  }
];
---

<BaseLayout
  title="DIS传感器实验 | 育才物理创新实验室"
  description="DIS传感器实验：使用 ESP32 + HC-SR04P 超声波传感器追踪小车运动，实时采集距离数据，绘制 x-t、v-t 图并导出 CSV 与结果图片。"
>
  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
        <div>
          <p class="eyebrow">PART 03 · DIS SENSOR LAB</p>
          <h1 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-5xl">
            DIS传感器实验：<br />超声波追踪小车运动
          </h1>
        </div>
        <p class="leading-8 text-slate-700">
          本项目使用 ESP32 和 HC-SR04P 超声波传感器搭建数字化物理实验装置。它不要求先学复杂编程，而是从接线、烧录、采集数据开始，理解传感器如何把真实运动转换成可分析的图表。
        </p>
      </div>

      <a href="/project-learning/ultrasonic-lab/" class="focus-ring mt-8 inline-flex h-12 items-center justify-center rounded-md bg-yucai-700 px-6 text-sm font-black text-white transition hover:bg-yucai-800">
        进入超声波在线实验室
      </a>
    </div>
  </section>

  <section class="section-band bg-white">
    <div class="page-shell">
      <div class="grid gap-5 lg:grid-cols-2">
        <div class="rounded-lg border border-slate-200 border-l-4 border-l-yucai-500 bg-white p-6 shadow-soft">
          <h2 class="text-lg font-black text-yucai-700">实验目标</h2>
          <figure class="mt-4 overflow-hidden rounded-md border border-slate-200 bg-lab">
            <img
              src={ultrasonicExperiment.image.src}
              alt={ultrasonicExperiment.image.alt}
              loading="lazy"
              class="w-full"
            />
          </figure>
          <p class="mt-3 leading-8 text-slate-700">{ultrasonicExperiment.goal}</p>
          <div class="mt-4 rounded-md bg-yucai-50 px-4 py-3">
            <span class="text-xl font-bold text-ink" set:html={ultrasonicExperiment.formula} />
            <span class="ml-2 text-xs text-slate-600" set:html={ultrasonicExperiment.formulaNote} />
          </div>
          <p class="mt-3 leading-8 text-slate-700">{ultrasonicExperiment.principle}</p>
        </div>

        <div class="rounded-lg border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-soft">
          <h2 class="text-lg font-black text-emerald-700">接线方式</h2>
          <p class="mt-3 text-sm leading-7 text-slate-700">使用 3.3V 供电的 HC-SR04P 宽电压版，扩展板免面包板接线。</p>
          <div class="mt-3 overflow-hidden rounded-md border border-slate-200">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-100 text-xs font-bold text-slate-600">
                <tr><th class="px-4 py-2">HC-SR04P</th><th class="px-4 py-2">ESP32 扩展板</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100 font-mono text-slate-700">
                {ultrasonicExperiment.wiring.map(([a, b]) => (
                  <tr><td class="px-4 py-2 font-bold text-ink">{a}</td><td class="px-4 py-2">{b}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="mt-5 rounded-lg border border-slate-200 border-l-4 border-l-signal bg-white p-6 shadow-soft">
        <div class="flex flex-wrap items-baseline gap-3">
          <h2 class="text-lg font-black text-[#b9760a]">实验器材</h2>
          <span class="text-sm font-bold text-[#b9760a]">{ultrasonicExperiment.cost}</span>
        </div>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead class="text-xs font-bold text-slate-500">
              <tr><th class="py-2 pr-4">器材</th><th class="py-2 pr-4">规格 / 说明</th><th class="py-2">参考价格</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              {ultrasonicExperiment.gear.map(([n, spec, price]) => (
                <tr>
                  <td class="py-2 pr-4 font-bold text-ink">{n}</td>
                  <td class="py-2 pr-4">{spec}</td>
                  <td class="py-2 font-mono">{price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-5 grid gap-5 xl:grid-cols-[0.95fr_1.05fr]">
        <section class="rounded-lg border border-slate-200 border-l-4 border-l-yucai-500 bg-white p-6 shadow-soft">
          <div class="flex flex-wrap items-baseline gap-3">
            <h2 class="text-lg font-black text-yucai-700">器材实物</h2>
            <span class="text-sm font-bold text-slate-500">按图核对，不要漏掉扩展板和 4 根杜邦线</span>
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {hardwareImages.map((item) => (
              <figure class="overflow-hidden rounded-md border border-slate-200 bg-lab">
                <div class="aspect-[4/3] bg-white">
                  <img
                    src={item.src}
                    alt={item.name}
                    loading="lazy"
                    class="h-full w-full object-contain p-3"
                  />
                </div>
                <figcaption class="border-t border-slate-200 bg-white px-4 py-3">
                  <p class="font-black text-ink">{item.name}</p>
                  <p class="mt-1 text-sm leading-6 text-slate-600">{item.spec}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>

        <section class="rounded-lg border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-soft">
          <div class="flex flex-wrap items-baseline gap-3">
            <h2 class="text-lg font-black text-emerald-700">接线图</h2>
            <span class="text-sm font-bold text-slate-500">GPT Image 2 生成，按线序直观看连接关系</span>
          </div>
          <div class="mt-5 overflow-hidden rounded-md border border-slate-200 bg-[#f8fafc]">
            <img
              src="/images/project-learning/dis-sensor/esp32-hc-sr04p-wiring-gpt-image2.webp"
              alt="ESP32 扩展板连接 HC-SR04P 超声波模块接线图：红线 VCC 到 3V3，黄线 Trig 到 G5，蓝线 Echo 到 G18，黑线 GND 到 GND"
              loading="lazy"
              class="w-full"
            />
          </div>
          <p class="mt-3 rounded-md bg-amber-50/80 px-4 py-3 text-sm leading-6 text-slate-700">
            图片用于快速看懂线序，实际操作时以接线表和下方文字图例为准；特别注意 VCC 接 3V3，不要接 5V。
          </p>
          <ul class="mt-4 grid gap-2 text-sm leading-6 text-slate-700 sm:grid-cols-2">
            <li><strong class="text-red-700">红线：</strong>HC-SR04P VCC → 扩展板 3V3</li>
            <li><strong class="text-slate-900">黑线：</strong>HC-SR04P GND → 扩展板 GND</li>
            <li><strong class="text-amber-700">黄线：</strong>HC-SR04P Trig → 扩展板 G5</li>
            <li><strong class="text-blue-700">蓝线：</strong>HC-SR04P Echo → 扩展板 G18</li>
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="section-band bg-lab">
    <div class="page-shell">
      <p class="eyebrow">TWO MOTIONS</p>
      <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl">两个实验任务</h2>
      <div class="mt-8 grid gap-5 lg:grid-cols-2">
        {ultrasonicExperiment.experiments.map((exp, i) => {
          const accent = i === 0
            ? { border: 'border-l-sky-500', tag: 'bg-sky-500 text-white', heading: 'text-sky-700' }
            : { border: 'border-l-amber-500', tag: 'bg-signal text-ink', heading: 'text-[#b9760a]' };
          return (
            <div class:list={['rounded-lg border border-slate-200 border-l-4 bg-white p-6 shadow-soft', accent.border]}>
              <div class="flex items-center gap-3">
                <span class:list={['rounded-md px-2.5 py-1 text-xs font-black', accent.tag]}>{exp.tag}</span>
                <h3 class:list={['text-lg font-black', accent.heading]}>{exp.name}</h3>
              </div>
              <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm leading-7 text-slate-700">
                {exp.points.map((p) => <li>{p}</li>)}
              </ol>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-band bg-white">
    <div class="page-shell">
      <p class="eyebrow">DATA ANALYSIS</p>
      <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl">数据分析与报告</h2>
      <p class="mt-4 max-w-3xl leading-8 text-slate-700">
        这个项目的重点不是“传感器读到了数”，而是把连续距离数据变成 x-t、v-t 图像，并用图像特征判断小车运动规律。报告中要保留原始 CSV、关键图像和误差解释。
      </p>

      <div class="mt-8 grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-lg border border-slate-200 border-l-4 border-l-teal-500 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-black text-teal-700">报告必须回答的问题</h3>
          <ol class="mt-4 space-y-3 text-sm leading-7 text-slate-700">
            {ultrasonicExperiment.thinking.map((t) => (
              <li class="flex gap-3">
                <span class="mt-1 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-teal-600 text-xs font-black text-white">?</span>
                <span>{t}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          {[
            ['原始数据', '导出或复制 CSV，保留 time_ms 与 distance_cm 两列，不只截图最终图像。'],
            ['图像证据', '匀速运动看 x-t 是否近似直线；匀变速运动看 x-t 是否接近抛物线、v-t 是否近似直线。'],
            ['误差解释', '结合反射面、传感器对准、轨道平直度和离群点处理，解释图像偏差。']
          ].map(([title, text]) => (
            <div class="rounded-lg border border-yucai-200 bg-yucai-50/70 p-5">
              <p class="text-sm font-black text-yucai-700">{title}</p>
              <p class="mt-2 text-sm leading-7 text-slate-700">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-band bg-lab">
    <div class="page-shell grid gap-6 lg:grid-cols-[1fr_0.9fr]">
      <details class="min-w-0 rounded-lg border border-slate-200 border-l-4 border-l-violet-500 bg-white p-6 shadow-soft" open>
        <summary class="focus-ring cursor-pointer list-none text-lg font-black text-violet-700">
          数据采集程序（MicroPython）
        </summary>
        <p class="mt-3 text-sm leading-7 text-slate-700">
          烧录后 ESP32 会通过串口持续打印 <code class="rounded bg-slate-100 px-1 font-mono">time_ms,distance_cm</code>，在线实验室会把这些数据转换成 x-t 和 v-t 图。
        </p>
        <pre class="mt-4 max-h-96 overflow-auto rounded-md bg-slate-950 p-4 text-xs leading-5 text-slate-200"><code>{collectorProgram}</code></pre>
      </details>

      <aside class="min-w-0 space-y-5">
        <div class="rounded-lg border border-slate-200 border-l-4 border-l-rose-500 bg-white p-6 shadow-soft">
          <h2 class="text-lg font-black text-rose-600">实验注意事项</h2>
          <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-700">
            {ultrasonicExperiment.cautions.map((c) => <li class="list-disc pl-1">{c}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
