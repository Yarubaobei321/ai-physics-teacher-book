---
import BaseLayout from '../../components/BaseLayout.astro';
import { projectTracks, reportSpec } from '../../data/project-learning';

const accentClass = {
  blue: {
    border: 'border-l-yucai-600',
    tag: 'text-yucai-700',
    button: 'bg-yucai-700 text-white group-hover:bg-yucai-800'
  },
  amber: {
    border: 'border-l-signal',
    tag: 'text-[#b9760a]',
    button: 'bg-signal text-ink group-hover:bg-[#e49412]'
  },
  emerald: {
    border: 'border-l-emerald-500',
    tag: 'text-emerald-700',
    button: 'bg-emerald-600 text-white group-hover:bg-emerald-700'
  }
};
---

<BaseLayout
  title="项目式学习 | 育才物理创新实验室"
  description="高中物理暑假项目式学习分为新高一、新高二和 DIS 传感器实验三类，支持网页填写数据表、自动生成图表并导出 CSV 与结果图片。"
>
  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">PROJECT-BASED LEARNING</p>
          <h1 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-5xl">
            高中物理暑假<br />项目式学习
          </h1>
        </div>
        <p class="leading-8 text-slate-700">
          这套暑假项目按学生基础分成三类：新高一完成本地重力加速度测量，新高二完成更规范的力学综合探究，科创兴趣学生挑战
          ESP32 + 超声波传感器数字化实验。每类页面都提供可填写的数据表、自动计算和图表导出。
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {
          projectTracks.map((track) => {
            const accent = accentClass[track.accent];
            return (
              <a
                href={track.href}
                class:list={[
                  'focus-ring group flex h-full flex-col rounded-md border border-slate-200 border-l-4 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:border-yucai-200',
                  accent.border
                ]}
              >
                <p class:list={['text-sm font-black', accent.tag]}>{track.tag} · {track.audience}</p>
                <h2 class="mt-4 text-2xl font-black leading-tight text-ink">{track.title}</h2>
                <p class="mb-6 mt-4 flex-1 leading-7 text-slate-700">{track.summary}</p>
                <span class:list={['mt-auto inline-flex h-10 items-center justify-center self-start rounded-md px-4 text-sm font-black transition', accent.button]}>
                  {track.status}
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section-band bg-white">
    <div class="page-shell grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">HOW IT WORKS</p>
        <h2 class="mt-3 text-2xl font-black text-ink sm:text-3xl">数据处理不再另开 Excel</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {['填写实验原始数据', '自动计算关键物理量', '导出 CSV 与结果图片'].map((item, index) => (
          <div class="rounded-md border border-slate-200 bg-lab p-5">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-yucai-700 text-sm font-black text-white">{index + 1}</span>
            <p class="mt-4 font-bold leading-7 text-ink">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band bg-gradient-to-br from-signal/15 via-amber-50 to-white">
    <div class="page-shell">
      <div class="grid gap-6 rounded-lg border-2 border-signal/40 bg-white p-6 shadow-soft lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-black text-[#b9760a]">完成优秀 · 奖励机制</p>
          <h2 class="mt-3 text-2xl font-black leading-tight text-ink sm:text-3xl">
            认真完成项目，有机会优先获得后续科创资源
          </h2>
          <p class="mt-4 leading-8 text-slate-700">
            项目式学习会统一评比。网页导出的数据图、CSV、实验照片和完整报告都可以作为成果证据，完成质量越高，越容易进入后续展示与科创培养名单。
          </p>
        </div>
        <div class="grid gap-3">
          {reportSpec.rewards.map((reward, index) => (
            <div class="flex gap-3 rounded-md border border-amber-200 bg-amber-50/70 p-4">
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-md bg-signal text-sm font-black text-ink">{index + 1}</span>
              <p class="leading-7 text-slate-700">{reward}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
