---
import BaseLayout from '../../components/BaseLayout.astro';
import ProjectAnalysisWorkbench from '../../components/ProjectAnalysisWorkbench.astro';
import {
  gradeTwoExperiments,
  gradeTwoReportSpec,
  gradeTwoUpgradeTasks,
  gradeTwoWorkbenches
} from '../../data/project-learning';
---

<BaseLayout
  title="新高二项目式学习 | 育才物理创新实验室"
  description="新高二暑假项目式学习：完成测 g 升级版与力学综合探究实验，使用图像法数据处理、可填写表格、自动图表和 CSV/图片导出。"
>
  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
        <div>
          <p class="eyebrow">PART 02 · NEW GRADE TWO</p>
          <h1 class="mt-3 text-3xl font-black leading-tight text-ink sm:text-5xl">
            新高二：力学综合<br />探究实验
          </h1>
        </div>
        <p class="leading-8 text-slate-700">
          新高二项目面向已经学完运动学、力学、曲线运动、机械能和部分动量/振动内容的同学。相比新高一，重点从“测出一个值”升级为“用图像、模型和误差分析说明结论为什么可信”。
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {gradeTwoUpgradeTasks.map((task) => (
          <article class="rounded-md border border-slate-200 border-l-4 border-l-signal bg-white p-6 shadow-soft">
            <h2 class="text-xl font-black text-ink">{task.title}</h2>
            <p class="mt-3 leading-7 text-slate-700">{task.text}</p>
            <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
              {task.points.map((point) => <li class="list-disc pl-1">{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band bg-lab">
    <div class="page-shell">
      <p class="eyebrow">MECHANICS PROJECTS</p>
      <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl">B 类力学综合实验</h2>
      <p class="mt-4 max-w-3xl leading-8 text-slate-700">
        B 类项目基于必修二和选择性必修一内容，要求学生完成“建模—测量—作图—解释”的完整链条。建议从下面 5 个项目中选择 1 个，与 A 类测 g 升级版共同组成新高二暑假项目。
      </p>

      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {[
          ['任务要求', '至少完成两个实验，必须包含一个 A 类和一个 B 类。'],
          ['数据要求', 'B 类实验也要保留原始数据，并尽量使用散点图、拟合线、偏差或守恒对比。'],
          ['报告重点', '不要只写“实验成功”，要解释结论为什么可信，以及最大误差来自哪里。']
        ].map(([title, text]) => (
          <div class="rounded-md border border-yucai-200 bg-white p-5 shadow-soft">
            <p class="text-sm font-black text-yucai-700">{title}</p>
            <p class="mt-2 leading-7 text-slate-700">{text}</p>
          </div>
        ))}
      </div>

      <div id="grade-two-experiment-tabs" class="mt-8 flex flex-wrap gap-2">
        {gradeTwoExperiments.map((exp, i) => (
          <button
            type="button"
            class="grade-two-experiment-tab group focus-ring flex items-center gap-2 rounded-md border px-4 py-2.5 text-left text-sm font-bold transition data-[active=true]:border-yucai-600 data-[active=true]:bg-yucai-700 data-[active=true]:text-white data-[active=false]:border-slate-300 data-[active=false]:bg-white data-[active=false]:text-slate-700 data-[active=false]:hover:border-yucai-300"
            data-grade-two-experiment-tab={i}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-black text-yucai-800 group-data-[active=true]:bg-white">{exp.code}</span>
            <span>{exp.title}</span>
          </button>
        ))}
      </div>

      <div class="mt-6">
        {gradeTwoExperiments.map((exp, i) => (
          <article
            class="grade-two-experiment-panel scroll-mt-32 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-soft data-[active=false]:hidden"
            data-grade-two-experiment-panel={i}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <div class="border-b border-yucai-100 bg-yucai-50 px-6 py-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-md bg-yucai-700 px-3 py-1 text-xs font-black text-white">{exp.code}</span>
                <h3 class="text-2xl font-black text-ink">{exp.title}</h3>
              </div>
              <p class="mt-3 max-w-4xl leading-7 text-slate-700">{exp.goal}</p>
              <p class="mt-3 inline-flex rounded-md bg-white px-3 py-2 font-mono text-sm font-bold text-yucai-900">{exp.formula}</p>
            </div>

            <div class="grid gap-6 p-6 lg:grid-cols-[1.05fr_0.95fr]">
              <div>
                <figure class="mb-5 overflow-hidden rounded-md border border-slate-200 bg-lab">
                  <img
                    src={exp.image.src}
                    alt={exp.image.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="w-full"
                  />
                </figure>
                <h4 class="text-sm font-black text-yucai-700">实验原理</h4>
                <p class="mt-2 leading-8 text-slate-700">{exp.principle}</p>

                <h4 class="mt-6 text-sm font-black text-yucai-700">操作步骤</h4>
                <ol class="mt-2 list-decimal space-y-2 pl-5 leading-7 text-slate-700">
                  {exp.steps.map((step) => <li>{step}</li>)}
                </ol>
              </div>

              <div class="space-y-5">
                <div class="rounded-md bg-lab p-5">
                  <h4 class="text-sm font-black text-yucai-700">实验器材</h4>
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-7 text-slate-700">
                    {exp.gear.map((item) => <li>{item}</li>)}
                  </ul>
                </div>

                <div class="rounded-md border border-amber-200 bg-amber-50/80 p-5">
                  <h4 class="text-sm font-black text-[#b9760a]">数据处理要点</h4>
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-7 text-slate-700">
                    {exp.dataTips.map((tip) => <li>{tip}</li>)}
                  </ul>
                </div>

                <div class="rounded-md border border-yucai-200 bg-white p-5">
                  <h4 class="text-sm font-black text-slate-600">网页工具建议</h4>
                  <p class="mt-2 text-sm leading-7 text-slate-700">{exp.workbenchHint}</p>
                  {exp.link ? (
                    <a href={exp.link} class="focus-ring mt-4 inline-flex h-10 items-center justify-center rounded-md bg-yucai-700 px-4 text-sm font-black text-white transition hover:bg-yucai-800">
                      打开在线实验室
                    </a>
                  ) : (
                    <a href="#grade-two-workbench" class="focus-ring mt-4 inline-flex h-10 items-center justify-center rounded-md border border-yucai-600 px-4 text-sm font-bold text-yucai-700 transition hover:bg-yucai-50">
                      打开下方工作台
                    </a>
                  )}
                </div>
              </div>
            </div>

            <div class="border-t border-yucai-100 bg-slate-50/70 p-5 sm:p-6">
              <p class="text-sm font-black text-yucai-700">切换其他 B 类方案</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {gradeTwoExperiments.map((option, optionIndex) => (
                  <button
                    type="button"
                    class="grade-two-experiment-tab group focus-ring flex items-center gap-2 rounded-md border px-4 py-2.5 text-left text-sm font-bold transition data-[active=true]:border-yucai-600 data-[active=true]:bg-yucai-700 data-[active=true]:text-white data-[active=false]:border-slate-300 data-[active=false]:bg-white data-[active=false]:text-slate-700 data-[active=false]:hover:border-yucai-300"
                    data-grade-two-experiment-tab={optionIndex}
                    data-active={optionIndex === i ? 'true' : 'false'}
                  >
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-black text-yucai-800 group-data-[active=true]:bg-white">{option.code}</span>
                    <span>{option.title}</span>
                  </button>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <script>
      const experimentTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-grade-two-experiment-tab]'));
      const experimentPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-grade-two-experiment-panel]'));
      const activateExperiment = (index: number) => {
        experimentTabs.forEach((tab) => {
          tab.dataset.active = tab.dataset.gradeTwoExperimentTab === String(index) ? 'true' : 'false';
        });
        experimentPanels.forEach((panel) => {
          panel.dataset.active = panel.dataset.gradeTwoExperimentPanel === String(index) ? 'true' : 'false';
        });
        window.setTimeout(() => window.dispatchEvent(new Event('resize')), 0);
      };
      experimentTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const index = Number(tab.dataset.gradeTwoExperimentTab);
          activateExperiment(index);
          if (tab.dataset.gradeTwoScroll === 'true') {
            window.setTimeout(() => {
              experimentPanels[index]?.scrollIntoView({ block: 'start', behavior: 'smooth' });
            }, 0);
          }
        });
      });
    </script>
  </section>

  <section id="grade-two-workbench" class="section-band bg-white scroll-mt-20">
    <div class="page-shell">
      <ProjectAnalysisWorkbench
        title="新高二图像法与守恒分析工作台"
        intro="选择一种数据处理模型，填写实验原始数据。网页会自动生成斜率、拟合图像、守恒偏差等关键结果，帮助你把“表格”变成报告中真正有解释力的图像。"
        workbenches={gradeTwoWorkbenches}
      />
      <div class="mt-6 rounded-md border border-yucai-100 bg-lab p-5">
        <p class="text-sm font-black text-yucai-700">切换 B 类实验方案</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {gradeTwoExperiments.map((option, optionIndex) => (
            <button
              type="button"
              class="grade-two-experiment-tab group focus-ring flex items-center gap-2 rounded-md border px-4 py-2.5 text-left text-sm font-bold transition data-[active=true]:border-yucai-600 data-[active=true]:bg-yucai-700 data-[active=true]:text-white data-[active=false]:border-slate-300 data-[active=false]:bg-white data-[active=false]:text-slate-700 data-[active=false]:hover:border-yucai-300"
              data-grade-two-experiment-tab={optionIndex}
              data-grade-two-scroll="true"
              data-active={optionIndex === 0 ? 'true' : 'false'}
            >
              <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-black text-yucai-800 group-data-[active=true]:bg-white">{option.code}</span>
              <span>{option.title}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-band bg-white">
    <div class="page-shell grid gap-10 lg:grid-cols-[1fr_0.9fr]">
      <div>
        <p class="eyebrow">REPORT FORMAT</p>
        <h2 class="mt-3 text-2xl font-black text-ink sm:text-3xl">报告结构要求</h2>
        <ol class="mt-5 space-y-3">
          {gradeTwoReportSpec.structure.map((item, index) => (
            <li class="flex gap-3 rounded-md bg-lab p-4 leading-7 text-slate-700">
              <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-yucai-700 text-xs font-black text-white">{index + 1}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
      <aside class="rounded-md border border-amber-200 bg-amber-50/80 p-6">
        <p class="text-sm font-black text-[#b9760a]">写作提醒</p>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-700">
          {gradeTwoReportSpec.reminders.map((item) => <li class="list-disc pl-1">{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
