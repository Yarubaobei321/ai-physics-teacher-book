    title: '焊接实训',
    desc: '从元器件识别到电路装调'
  },
  {
    src: '/maker/smart-hardware/images/solidworks-01.webp',
    title: 'SolidWorks 建模',
    desc: '把结构设想变成可装配模型'
  },
  {
    src: '/maker/smart-hardware/images/structure-aluminum-02.webp',
    title: '铝型材结构',
    desc: '标准件连接与实体装配'
  },
  {
    src: '/maker/smart-hardware/images/nanshan-competition-01.webp',
    title: '参加南山区比赛',
    desc: '带着智能硬件作品走上区级赛场'
  },
  {
    src: '/maker/smart-hardware/images/smart-car-build-01.webp',
    title: '小车底盘装配',
    desc: '电机、驱动板与控制器集成'
  },
  {
    src: '/maker/smart-hardware/images/smart-car-build-03.webp',
    title: '传感器调试',
    desc: '循迹、避障与串口观察'
  },
  {
    src: '/maker/smart-hardware/images/smart-car-build-04.webp',
    title: '系统联调',
    desc: '让结构、电路和程序进入同一闭环'
  },
  {
    src: '/maker/smart-hardware/images/soldering-02.webp',
    title: '电路焊接与装调',
    desc: '把原理图变成可测量、可运行的电路'
  },
  {
    src: '/maker/smart-hardware/images/soldering-03.webp',
    title: '电子制作过程',
    desc: '通过反复测量定位问题'
  },
  {
    src: '/maker/smart-hardware/images/soldering-04.webp',
    title: '焊接作品检查',
    desc: '让电路先稳定，再进入系统联调'
  },
  {
    src: '/maker/smart-hardware/images/solidworks-02.webp',
    title: '三维结构迭代',
    desc: '从尺寸约束到装配验证'
  },
  {
    src: '/maker/smart-hardware/images/solidworks-03.webp',
    title: '创新结构设计',
    desc: '为智能系统预留安装空间'
  },
  {
    src: '/maker/smart-hardware/images/structure-aluminum-04.webp',
    title: '结构件应用',
    desc: '把模型、材料和连接方式对应起来'
  }
];

const gallerySlides = [
  {
    src: '/maker/smart-hardware/images/soldering-01.webp',
    title: '焊接与电子制作',
    desc: '从认识元器件到焊接调试，先把电路做可靠。'
  },
  {
    src: '/maker/smart-hardware/images/solidworks-01.webp',
    title: '三维建模',
    desc: '用 SolidWorks 建立结构模型，再考虑装配和受力。'
  },
  {
    src: '/maker/smart-hardware/images/structure-aluminum-02.webp',
    title: '铝型材结构',
    desc: '把结构件装配成真实机构，理解标准件和连接方式。'
  },
  {
    src: '/maker/smart-hardware/images/smart-scale-01.webp',
    title: '智能电子秤',
    desc: '传感器采集、数据处理和作品外观同时进入调试。'
  },
  {
    src: '/maker/smart-hardware/images/smart-car-build-01.webp',
    title: '智能小车制作',
    desc: '把底盘、电机、传感器、驱动板和 ESP32 装到同一系统里。'
  },
  {
    src: '/maker/smart-hardware/images/smart-car-build-02.webp',
    title: '三红外三循迹小车',
    desc: '最终版支持避障、循迹和 2.4G 手动遥控。'
  },
  {
    src: '/maker/smart-hardware/images/smart-car-build-03.webp',
    title: '循迹与避障调试',
    desc: '观察传感器状态，再调整阈值和程序动作。'
  },
  {
    src: '/maker/smart-hardware/images/smart-car-build-04.webp',
    title: '系统联调',
    desc: '把机械、电路、程序和遥控链路放到一起检查。'
  },
  {
    src: '/maker/smart-hardware/images/soldering-02.webp',
    title: '焊点与元器件检查',
    desc: '先把基础电路做稳定，后面的系统调试才有意义。'
  },
  {
    src: '/maker/smart-hardware/images/soldering-03.webp',
    title: '电路板制作过程',
    desc: '从工具使用到焊接质量，训练工程细节。'
  },
  {
    src: '/maker/smart-hardware/images/soldering-04.webp',
    title: '电路装调复盘',
    desc: '用测量结果反推接线和元件状态。'
  },
  {
    src: '/maker/smart-hardware/images/solidworks-02.webp',
    title: '结构建模迭代',
    desc: '尺寸、孔位和装配关系需要在模型里提前验证。'
  },
  {
    src: '/maker/smart-hardware/images/solidworks-03.webp',
    title: '创新结构设计',
    desc: '为传感器、控制板和运动机构预留安装空间。'
  },
  {
    src: '/maker/smart-hardware/images/structure-aluminum-04.webp',
    title: '标准件与结构件',
    desc: '把模型中的结构转化为可装配的真实框架。'
  }
];

const videos = [
  {
    title: '智能小车课堂演示 01',
    src: '/maker/smart-hardware/videos/smart-car-demo-01.mp4',
    poster: '/maker/smart-hardware/videos/smart-car-demo-01-poster.webp'
  },
  {
    title: '智能小车课堂演示 02',
    src: '/maker/smart-hardware/videos/smart-car-demo-02.mp4',
    poster: '/maker/smart-hardware/videos/smart-car-demo-02-poster.webp'
  },
  {
    title: '智能小车课堂演示 03',
    src: '/maker/smart-hardware/videos/smart-car-demo-03.mp4',
    poster: '/maker/smart-hardware/videos/smart-car-demo-03-poster.webp'
  }
];

const smartCarPrinciples = [
  {
    title: 'ESP32 状态机',
    desc: '程序先读取模式按键和传感器，再按“停车、避障、循迹、2.4G 手动”四种状态选择动作，避免多个逻辑同时抢电机。'
  },
  {
    title: '三红外避障',
    desc: '车头左、中、右红外避障模块分别接 GPIO36、GPIO39、GPIO34。检测到障碍时对应输入为 LOW，正前方受阻会先停车或后退，再向安全方向修正。'
  },
  {
    title: '三路 TCRT5000 循迹',
    desc: '左、中、右循迹模块接 GPIO35、GPIO32、GPIO33。黑线通常读为 HIGH，中间压线直行，左侧压线向左修正，右侧压线向右修正，三路都丢线则停车。'
  },
  {
    title: 'DRV8833 电机驱动',
    desc: 'ESP32 不直接带动电机，而是输出 PWM 给 DRV8833。电机电源、ESP32 地线必须共地，使能或睡眠脚保持有效，左右轮再通过差速完成转弯。'
  },
  {
    title: '遥控失联保护',
    desc: '2.4G 接收机通过 RX2 接收 9600 波特率数据帧。手动模式下超过 400ms 没有有效帧，程序会立即把左右轮 PWM 归零。'
  },
  {
    title: '起步冲量与平滑加速',
    desc: '小直流电机静摩擦较大，起步时需要短暂冲量；进入稳定运动后再平滑调整 PWM，减少突然抖动和轮胎打滑。'
  }
];

const roverPrinciples = [
  {
    title: '网页地面站链路',
    desc: '网页通过 Web Bluetooth 连接 B 板，B 板负责通信、传感器汇总和任务调度，再通过 UART 把运动命令交给 A 板执行。'
  },
  {
    title: '运动安全门',
    desc: '地面站、B 板和 A 板都保留安全边界：连接状态异常、急停、超时或传感器风险出现时，运动命令会被限制或清零。'
  },
  {
    title: '底盘驱动与反馈',
    desc: 'A 板控制 TB6612 电机驱动，编码器反馈轮速，程序用目标速度和实际速度的差值修正 PWM，让六轮平台更平稳。'
  },
  {
    title: '环境感知',
    desc: 'TOF 测距、IMU 姿态、循迹传感器和电源数据一起进入状态判断，让火星车能在巡检、避障和演示任务之间切换。'
  },
  {
    title: '能源与沙尘任务',
    desc: '太阳能板舵机根据光照方向调整角度，风扇用于演示沙尘清理。网页端把这些动作组织成可观察的任务流程。'
  },
  {
    title: '教学演示边界',
    desc: '网站里的智能小车控制台是教学演示版；火星车地面站页面面向真实设备，但真实上车前仍需要完成供电、共地、急停和串口日志检查。'
  }
];

const projectEntries = [
  {
    name: '三红外三循迹智能小车',
    badge: 'ESP32 · DRV8833 · 三红外 · 三循迹',
    label: '教学控制台',
    desc: '从共地、使能脚、电机供电开始，到状态机、循迹决策、避障决策、2.4G 遥控失联保护，完整展示一台可调试小车的工程链路。',
    image: '/maker/smart-hardware/images/smart-car-infographic.webp',
    imageAlt: '三红外三循迹智能小车感知、决策、驱动和安全保护信息图',
    principles: smartCarPrinciples,
    steps: ['传感器采样', '状态机决策', 'DRV8833 差速驱动', '失联急停'],
    primaryHref: '/projects/smart-car/',
    primaryCta: '进入教学控制台',
    secondaryHref: '/maker/smart-car/',
    secondaryCta: '查看作品说明',
    note: '教学演示版不会向真车发送指令，适合先讲清楚模式切换和安全边界。'
  },
  {
    name: '尘光一号火星车',
    badge: 'Web Bluetooth · 双 ESP32 · TB6612',
    label: '网页地面站',
    desc: '面向火星基地巡检任务的六轮智能平台，集成网页蓝牙通信、双控制板、电机驱动、环境感知、能源管理和安全保护。',
    image: '/maker/smart-hardware/images/mars-rover-infographic.webp',
    imageAlt: '尘光一号火星车地面站通信、感知、运动、能源和安全信息图',
    principles: roverPrinciples,
    steps: ['网页蓝牙连接', 'B 板任务调度', 'A 板运动控制', '多重安全保护'],
    primaryHref: '/projects/mars-rover/',
    primaryCta: '进入网页地面站',
    secondaryHref: '/maker/mars-rover/',
    secondaryCta: '查看项目说明',
    note: '面向真实设备演示，连接前仍要确认供电、共地、急停和串口日志。'
  }
];
---

<BaseLayout
  title="科创天地 | 育才物理创新实验室"
  description="科创天地：智能硬件物理创新实验作品展示，整合电路设计、结构设计、3D 打印、ESP32 智能控制、智能小车和火星车项目。"
  ogImage="/maker/smart-hardware/images/course-overview.webp"
>
  <section
    class="hero-carousel"
    data-carousel
    data-autoplay="5500"
    aria-roledescription="carousel"
    aria-label="科创天地图片轮播"
  >
    <div class="hero-stage">
      {heroSlides.map((slide, index) => (
        <figure
          class:list={['hero-slide', index === 0 && 'is-active']}
          data-slide
          data-title={slide.title}
          data-desc={slide.desc}
          aria-hidden={index !== 0}
        >
          <img
            src={slide.src}
            alt={slide.title}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
      ))}
      <div class="hero-scrim" aria-hidden="true"></div>
    </div>

    <div class="hero-overlay">
      <div class="hero-overlay-inner">
        <p class="hero-eyebrow">MAKER SPACE · 科创天地</p>
        <h1 class="hero-title">科创天地</h1>
        <p class="hero-lead">
          育才物理创新实验室的智能硬件创新实验作品。从电路、结构、程序三个方向入手，把物理课堂里的想法做成会感知、会运动、能被调试的真实装置。
        </p>
        <div class="hero-actions">
          <a href="#course" class="hero-btn hero-btn--primary">查看课程模块</a>
          <a href="/projects/smart-car/" class="hero-btn hero-btn--ghost">打开智能小车控制台</a>
        </div>
      </div>
    </div>

    <button type="button" class="hero-arrow hero-arrow--prev" data-prev aria-label="上一张">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="hero-arrow hero-arrow--next" data-next aria-label="下一张">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="hero-controls page-shell">
      <p class="hero-caption" data-caption>
        <strong data-caption-title>{heroSlides[0].title}</strong>
        <span data-caption-desc>{heroSlides[0].desc}</span>
      </p>
      <div class="hero-dots" data-dots role="tablist" aria-label="选择幻灯片">
        {heroSlides.map((slide, index) => (
          <button
            type="button"
            class:list={['hero-dot', index === 0 && 'is-active']}
            data-dot
            aria-label={`第 ${index + 1} 张：${slide.title}`}
          >
            <span class="hero-dot-fill" data-dot-fill></span>
          </button>
        ))}
      </div>
      <p class="hero-counter">
        <span data-counter-current>01</span><span class="hero-counter-sep">/</span><span data-counter-total></span>
      </p>
    </div>
  </section>

  <section id="course" class="section-band scroll-mt-20 bg-white">
    <div class="page-shell">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <figure class="course-poster">
          <img
            src="/maker/smart-hardware/images/course-overview.webp"
            alt="智能硬件赋能物理创新实验课程介绍"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="max-w-xl">
          <p class="eyebrow">课程 · COURSE</p>
          <h2 class="mt-3 text-3xl font-black tracking-normal text-ink sm:text-4xl">智能硬件课程</h2>
          <p class="mt-5 leading-8 text-slate-700">
            课程不只讲一个知识点，而是把“设计、制作、调试、展示”连成完整项目。学生需要看懂电路，做出结构，写进程序，再通过测试发现问题、修正问题。
          </p>
          <p class="mt-4 leading-8 text-slate-700">
            三个模块分别由汪小明、严力耕、黄灿斌老师带队，覆盖电路、结构与智能控制三个方向，最终在智能小车与火星车项目中完成系统集成。
          </p>
          <div class="mt-7 flex flex-wrap gap-2">
            {['嘉立创 EDA', 'PCB', '焊接', 'SolidWorks', '铝型材', 'ESP32', '传感器', '智能小车'].map((kw) => (
              <span class="rounded-full border border-yucai-200 bg-yucai-50 px-3 py-1 text-sm font-black text-yucai-700">{kw}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {courseModules.map((item, index) => (
          <article class:list={['flex flex-col rounded-lg border border-slate-200 border-t-4 bg-lab p-6 shadow-sm', item.accent]}>
            <p class="font-mono text-sm font-black text-yucai-700">MODULE 0{index + 1}</p>
            <h3 class="mt-3 text-xl font-black text-ink">{item.name}</h3>
            <p class="mt-1 text-sm font-bold text-slate-500">{item.teacher}</p>
            <ul class="mt-5 space-y-3 text-slate-700">
              {item.topics.map((topic) => (
                <li class="leading-7">• {topic}</li>
              ))}
            </ul>
            <p class="mt-auto border-t border-slate-200 pt-4 text-sm font-bold leading-7 text-slate-600">{item.result}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">课堂剪影 · MEDIA</p>
        <h2 class="mt-3 text-3xl font-black tracking-normal text-ink sm:text-4xl">从动手训练到系统作品</h2>
      </div>

      <div
        class="media-carousel"
        data-carousel
        data-autoplay="5000"
        aria-roledescription="carousel"
        aria-label="课堂剪影轮播图"
      >
        <div class="media-stage">
          {gallerySlides.map((photo, index) => (
            <figure
              class:list={['media-slide', index === 0 && 'is-active']}
              data-slide
              data-title={photo.title}
              data-desc={photo.desc}
              aria-hidden={index !== 0}
            >
              <img
                src={photo.src}
                alt={photo.title}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          ))}
          <div class="media-scrim" aria-hidden="true"></div>
          <p class="media-caption" data-caption>
            <strong data-caption-title>{gallerySlides[0].title}</strong>
            <span data-caption-desc>{gallerySlides[0].desc}</span>
          </p>
          <button type="button" class="hero-arrow hero-arrow--prev media-arrow" data-prev aria-label="上一张">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="hero-arrow hero-arrow--next media-arrow" data-next aria-label="下一张">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <div class="media-controls">
          <div class="hero-dots" data-dots role="tablist" aria-label="选择幻灯片">
            {gallerySlides.map((photo, index) => (
              <button
                type="button"
                class:list={['hero-dot', index === 0 && 'is-active']}
                data-dot
                aria-label={`第 ${index + 1} 张：${photo.title}`}
              >
                <span class="hero-dot-fill" data-dot-fill></span>
              </button>
            ))}
          </div>
          <p class="hero-counter hero-counter--dark">
