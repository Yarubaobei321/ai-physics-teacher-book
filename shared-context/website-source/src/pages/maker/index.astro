<script>
  const initCarousel = (root: HTMLElement) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    if (slides.length === 0) return;

    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const caption = root.querySelector<HTMLElement>('[data-caption]');
    const captionTitle = caption?.querySelector<HTMLElement>('[data-caption-title]') ?? null;
    const captionDesc = caption?.querySelector<HTMLElement>('[data-caption-desc]') ?? null;
    const currentEl = root.querySelector<HTMLElement>('[data-counter-current]');
    const totalEl = root.querySelector<HTMLElement>('[data-counter-total]');
    const delay = Number(root.dataset.autoplay) || 0;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer = 0;

    const pad = (n: number) => String(n).padStart(2, '0');
    if (totalEl) totalEl.textContent = pad(slides.length);

    const restartProgress = () => {
      dots.forEach((dot) => {
        const fill = dot.querySelector<HTMLElement>('[data-dot-fill]');
        if (fill) fill.style.animation = 'none';
      });
      if (reduce || !delay) return;
      const fill = dots[index]?.querySelector<HTMLElement>('[data-dot-fill]');
      if (fill) {
        void fill.offsetWidth;
        fill.style.animation = `carousel-fill ${delay}ms linear forwards`;
      }
    };

    const setActive = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, n) => {
        const on = n === index;
        slide.classList.toggle('is-active', on);
        slide.setAttribute('aria-hidden', String(!on));
      });
      dots.forEach((dot, n) => {
        const on = n === index;
        dot.classList.toggle('is-active', on);
        dot.setAttribute('aria-selected', String(on));
      });
      if (currentEl) currentEl.textContent = pad(index + 1);
      const active = slides[index];
      if (captionTitle) captionTitle.textContent = active.dataset.title ?? '';
      if (captionDesc) captionDesc.textContent = active.dataset.desc ?? '';
      restartProgress();
    };

    const stop = () => {
      if (timer) {
        window.clearTimeout(timer);
        timer = 0;
      }
    };

    const play = () => {
      stop();
      if (reduce || !delay) return;
      timer = window.setTimeout(() => {
        setActive(index + 1);
        play();
      }, delay);
    };

    const go = (step: number) => {
      setActive(index + step);
      play();
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    dots.forEach((dot, n) =>
      dot.addEventListener('click', () => {
        setActive(n);
        play();
      })
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', play);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', play);

    let startX: number | null = null;
    root.addEventListener(
      'touchstart',
      (event) => {
        startX = event.touches[0].clientX;
        stop();
      },
      { passive: true }
    );
    root.addEventListener('touchend', (event) => {
      if (startX === null) return;
      const dx = event.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
      else play();
      startX = null;
    });

    document.addEventListener('keydown', (event) => {
      if (!root.matches(':hover') && !root.contains(document.activeElement)) return;
      if (event.key === 'ArrowLeft') go(-1);
      if (event.key === 'ArrowRight') go(1);
    });

    setActive(0);
    play();
  };

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>

