---
import BaseLayout from '../../components/BaseLayout.astro';

const courseModules = [
  {
    name: '电路设计与电子制作模块',
    teacher: '汪小明老师',
    accent: 'border-sky-500',
    topics: [
      '基于嘉立创 EDA 的物理实验电路板设计与 PCB 制作',
      '电子元器件识别、焊接与电路装调实践'
    ],
    result: '让同学理解一块电路板从原理图、PCB、焊接到调试的完整流程。'
  },
  {
    name: '结构设计与 3D 打印模块',
    teacher: '严力耕老师',
    accent: 'border-emerald-500',
    topics: [
      'SolidWorks 三维建模与创新结构设计实践',
      '铝型材结构设计、装配'
    ],
    result: '让想法从草图变成可装配、可承重、可迭代的真实结构。'
  },
  {
    name: '智能控制与系统集成模块',
    teacher: '黄灿斌老师',
    accent: 'border-amber-500',
    topics: [
      '基于 ESP32 的数字化传感器教具开发与编程实践',
      '基于 ESP32 的智能小车设计、编程与综合调试'
    ],
    result: '把传感器、电机、程序和结构整合成能运行、能演示、能排查的作品。'
  }
];

const heroSlides = [
  {
    src: '/maker/smart-hardware/images/smart-car-build-02.webp',
