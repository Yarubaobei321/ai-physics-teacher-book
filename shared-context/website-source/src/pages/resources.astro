---
import BaseLayout from '../components/BaseLayout.astro';
import ResourceCatalog from '../components/ResourceCatalog.astro';
import '../styles/resources.css';
---

<BaseLayout title="查找教学资源 | 育才物理创新实验室" description="查找课堂演示模型、实验记录工具与硬件制作项目，按知识点搜索，收藏常用资源。">
  <div class="resource-page">
    <div class="page-shell">
      <header class="resource-page-heading">
        <a class="focus-ring text-sm font-bold text-yucai-700" href="/">← 返回首页</a>
        <h1>查找教学资源</h1>
        <p>备课时挑选演示模型，实验时记录与分析数据，课后继续动手探究。</p>
      </header>
      <ResourceCatalog />
    </div>
  </div>
</BaseLayout>
