---
import BaseLayout from '../../components/BaseLayout.astro';

const experiments = [
  {
    title: '落体法验证机械能守恒定律',
    tag: '方案一',
    text: '把纸带计数点位置转为速度、动能变化和重力势能变化，自动生成能量对比图。',
    href: '/online-lab/falling-body/',
    status: '开始实验'
  },
  {
    title: '沿曲线运动验证机械能守恒定律',
    tag: '方案二',
    text: '从 A、B、C 点静止释放金属圆柱体，读取双头光电门速度，比较势能减小和动能增加。',
    href: '/online-lab/curved-ramp/',
    status: '开始实验'
  },
  {
    title: '气垫导轨验证系统机械能守恒定律',
    tag: '方案三',
    text: '使用气垫导轨减少摩擦影响，释放重锤并读取两双头光电门速度，比较系统机械能变化。',
    href: '/online-lab/air-track/',
    status: '开始实验'
  }
];
---

<BaseLayout
  title="验证机械能守恒 | 育才物理创新实验室"
  description="验证机械能守恒的案例实验：落体法、沿曲线运动、气垫导轨三套方案，提供数据录入、自动计算和能量图表分析。"
>
  <section class="section-band bg-lab">
    <div class="page-shell">
      <a href="/online-lab/" class="focus-ring text-sm font-bold text-yucai-700 hover:text-yucai-800">← 返回在线实验室</a>
      <div class="mt-4 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">ONLINE LAB · 案例实验</p>
          <h1 class="mt-3 text-3xl font-black text-ink sm:text-5xl">验证机械能守恒</h1>
        </div>
        <p class="leading-8 text-slate-700">
          把纸带与光电门测量表格搬到网页中，让数据录入、计算和图像分析在浏览器里一次完成。下面三套方案任选其一开始。
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {
          experiments.map((experiment) => {
            const available = experiment.href !== '#';
            const content = (
              <>
                <p class="text-sm font-bold text-yucai-700">{experiment.tag}</p>
                <h2 class="mt-4 text-2xl font-black leading-tight text-ink">{experiment.title}</h2>
                <p class="mb-6 mt-4 min-h-[5.25rem] leading-7 text-slate-700">{experiment.text}</p>
                <span
                  class:list={[
                    'mt-auto inline-flex h-10 items-center justify-center self-start rounded-md px-4 text-sm font-bold transition',
                    available
                      ? 'bg-yucai-700 text-white group-hover:bg-yucai-800'
                      : 'border border-slate-300 text-slate-500'
                  ]}
                >
                  {experiment.status}
                </span>
              </>
            );

            return available ? (
              <a href={experiment.href} class="focus-ring group flex h-full flex-col rounded-md border border-slate-200 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:border-yucai-200">
                {content}
              </a>
            ) : (
              <article class="flex h-full flex-col rounded-md border border-slate-200 bg-white p-6 opacity-80">
                {content}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
