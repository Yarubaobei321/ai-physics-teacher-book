---
import BaseLayout from '../../components/BaseLayout.astro';

const entries = [
  {
    tag: '实验工具',
    title: '在线编程',
    text: '在浏览器里直连 ESP32（Web Serial），选择 MicroPython 程序模板，一键写入程序与库文件，无需安装本地环境。',
    href: '/programming/',
    status: '打开工具'
  },
  {
    tag: '实验工具',
    title: '网页版 DIS',
    text: '连接 ESP32 蓝牙，实时显示力、距离、单 / 双头光电门数据，绘制曲线、记录测量并导出 CSV。',
    href: '/dis/',
    status: '打开工具'
  },
  {
    tag: '案例实验',
    title: '验证机械能守恒',
    text: '落体法、沿曲线运动、气垫导轨三套方案，把测量表格搬到网页，自动计算与能量图像分析。',
    href: '/online-lab/mechanical-energy/',
    status: '进入实验'
  }
];
---

<BaseLayout
  title="在线实验室 | 育才物理创新实验室"
  description="在线实验室整合实验工具与案例实验：在浏览器里给 ESP32 写程序（在线编程）、采集传感器数据（网页版 DIS），并完成验证机械能守恒等可填写、可计算的网页实验。"
>
  <section class="section-band bg-lab">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">ONLINE LAB</p>
          <h1 class="mt-3 text-3xl font-black text-ink sm:text-5xl">在线实验室</h1>
        </div>
        <p class="leading-8 text-slate-700">
          把实验工具和案例实验整合在一个入口：在浏览器里给 ESP32 写程序、采集传感器数据，并完成可填写、可计算的网页实验报告。下面选择一个入口开始。
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {
          entries.map((entry) => (
            <a
              href={entry.href}
              class="focus-ring group flex h-full flex-col rounded-md border border-slate-200 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:border-yucai-200"
            >
              <p class="text-sm font-bold text-yucai-700">{entry.tag}</p>
              <h2 class="mt-4 text-2xl font-black leading-tight text-ink">{entry.title}</h2>
              <p class="mb-6 mt-4 min-h-[5.25rem] leading-7 text-slate-700">{entry.text}</p>
              <span class="mt-auto inline-flex h-10 items-center justify-center self-start rounded-md bg-yucai-700 px-4 text-sm font-bold text-white transition group-hover:bg-yucai-800">
                {entry.status}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
